#!/bin/sh
# pidly — a file-based issue tracker
#
# Every command here is something a person could do with mkdir, mv and an
# editor, leaving the repository byte-identical. The exception is claiming,
# which needs the lock to be safe while other agents are running.

set -eu

die() { printf 'pidly: %s\n' "$*" >&2; exit 1; }

# --- locating things -------------------------------------------------------

# The .pidly directory, found by walking up from the current directory.
root() {
	d=$PWD
	while [ "$d" != / ]; do
		[ -d "$d/.pidly" ] && { printf '%s\n' "$d/.pidly"; return 0; }
		d=$(dirname "$d")
	done
	die 'no .pidly directory found in this directory or any parent'
}

# The directory of one ticket, by number. One traversal, not a search per
# call: callers needing many lookups should use map() instead.
ticket_dir() {
	_td_r=$1 _td_n=$2
	_td_p=$(find "$_td_r" -type d -name "$_td_n" -print -quit)
	[ -n "$_td_p" ] || die "no ticket $_td_n"
	printf '%s\n' "$_td_p"
}

# Is a ticket closed, or held inside something closed? True when there is a
# c/ between it and the tracker root.
#
# Matched on the path relative to .pidly. An absolute path carries the
# checkout with it, and a checkout that lives under a directory named c —
# ~/c/pidly — would otherwise make every ticket in it look finished: claim
# would see nothing blocked and list would offer everything as ready, both
# wrong in the direction that loses work.
in_closed() {
	case ${2#"$1"/} in c/*|*/c/*) return 0 ;; *) return 1 ;; esac
}

# Every ticket as "number path", one line each, from a single traversal.
map() {
	find "$1" -mindepth 1 -type d '!' -name c '!' -name '.*' -printf '%f %p\n'
}

# --- identity and liveness -------------------------------------------------
#
# A pid means nothing on its own. It is meaningful only relative to a specific
# process table, and only until it is recycled. So a claim records both:
#
#   <pid>.<starttime>@<runtime>
#
# <starttime> distinguishes a recycled pid from the original: a new process
# reusing the number has a different start time. <runtime> identifies the
# process table — boot id, uid, and pid namespace where readable. Together
# they are a unique, checkable process identity the kernel maintains for free.
#
# This is why a plain unique id would not be an improvement. Uniqueness is the
# easy half; the hard half is liveness, and only the OS keeps a registry of
# live processes. A UUID has no registry behind it, so it would identify an
# agent without ever telling you whether that agent still exists.
#
# Agents with no reachable process table — anything in the cloud — cannot use
# any of this, and carry a lease instead.

runtime() {
	_rt_boot=""
	[ -r /proc/sys/kernel/random/boot_id ] &&
		read -r _rt_boot < /proc/sys/kernel/random/boot_id 2>/dev/null || true
	if [ -n "$_rt_boot" ]; then
		_rt_boot=${_rt_boot%%-*}
	else
		# No boot id: fall back to a per-checkout random string. Weaker,
		# because a checkout survives reboots and pids do not.
		_rt_boot=$(checkout_id "$1")
	fi
	_rt_ns=$(readlink /proc/self/ns/pid 2>/dev/null || true)
	case $_rt_ns in
	*"["*) _rt_ns=${_rt_ns#*[}; _rt_ns=".n${_rt_ns%]}" ;;
	*)     _rt_ns="" ;;
	esac
	printf '%s.u%s%s\n' "$_rt_boot" "$(id -u)" "$_rt_ns"
}

checkout_id() {
	_ci_f="$1/.id"
	if [ ! -f "$_ci_f" ]; then
		( umask 077
		  if [ -r /dev/urandom ]; then
			LC_ALL=C tr -dc 'a-z0-9' < /dev/urandom 2>/dev/null |
				dd bs=1 count=12 2>/dev/null > "$_ci_f"
		  else
			printf '%s%s' "$$" "$(date +%s)" > "$_ci_f"
		  fi
		  printf '\n' >> "$_ci_f" )
	fi
	read -r _ci_cid < "$_ci_f"
	printf '%s\n' "$_ci_cid"
}

starttime() { awk '{print $22}' "/proc/$1/stat" 2>/dev/null || true; }

# Is this process identity still running? Only called when the recorded
# runtime matches ours — same boot, same namespace, same uid — so our own
# processes are always visible and absence really does mean gone.
holder_alive() {
	case $1 in
	*.*) _ha_pid=${1%%.*}; _ha_start=${1#*.} ;;
	*)   _ha_pid=$1;       _ha_start="" ;;
	esac
	if [ -d /proc ]; then
		[ -r "/proc/$_ha_pid/stat" ] || return 1
		[ -z "$_ha_start" ] && return 0
		[ "$(starttime "$_ha_pid")" = "$_ha_start" ]
	else
		kill -0 "$_ha_pid" 2>/dev/null
	fi
}

# Who is claiming. An agent with a real process is identified by it; one
# without — a cloud agent, a CI job — names itself in PIDLY_AGENT and must
# carry a lease, because nothing else can establish that it is alive.
holder() {
	if [ -n "${PIDLY_AGENT:-}" ]; then
		case $PIDLY_AGENT in
		*@*|*" "*) die 'PIDLY_AGENT may not contain @ or spaces' ;;
		esac
		printf '%s@-\n' "$PIDLY_AGENT"
		return 0
	fi
	# CLAUDE_PID is the long-lived Claude Code process. $PPID usually
	# resolves to the same thing, but only because a tool call's shell is
	# a direct child of it — wrap the call and that stops being true.
	_ho_p=${PIDLY_PID:-${CLAUDE_PID:-$PPID}}
	kill -0 "$_ho_p" 2>/dev/null || die "PIDLY_PID=$_ho_p is not a running process"
	_ho_s=$(starttime "$_ho_p")
	if [ -n "$_ho_s" ]; then
		printf '%s.%s@%s\n' "$_ho_p" "$_ho_s" "$(runtime "$1")"
	else
		printf '%s@%s\n' "$_ho_p" "$(runtime "$1")"
	fi
}

# --- leases ----------------------------------------------------------------
#
# A lease is the only liveness signal available to an agent whose process
# table nobody else can reach. It is a promise with an end, not a heartbeat:
# no refresh traffic, and a claim whose holder dies frees itself on expiry.

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

iso_at() {
	date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null ||
	date -u -r "$1"  +%Y-%m-%dT%H:%M:%SZ 2>/dev/null ||
	die 'cannot compute a lease expiry: no usable date(1)'
}

# PIDLY_LEASE as 90s / 30m / 2h / 3d, or bare seconds.
lease_expiry() {
	case $1 in
	*s) _le_n=${1%s}; _le_m=1 ;;
	*m) _le_n=${1%m}; _le_m=60 ;;
	*h) _le_n=${1%h}; _le_m=3600 ;;
	*d) _le_n=${1%d}; _le_m=86400 ;;
	*)  _le_n=$1;     _le_m=1 ;;
	esac
	case $_le_n in
	''|*[!0-9]*) die "PIDLY_LEASE=$1 is not a duration (e.g. 90s, 30m, 2h)" ;;
	esac
	iso_at "$(( $(date -u +%s) + _le_n * _le_m ))"
}

# Timestamps are ISO-8601 UTC, so lexical order is chronological order.
expired() {
	[ -n "$1" ] || return 1
	[ "$(printf '%s\n%s\n' "$1" "$(now_iso)" | sort | head -1)" = "$1" ]
}

# Split a claim value; sets _c_holder, _c_runtime, _c_expiry.
parse_claim() {
	case $1 in
	*" "*) _c_who=${1% *}; _c_expiry=${1##* } ;;
	*)     _c_who=$1;      _c_expiry="" ;;
	esac
	_c_runtime=${_c_who##*@}
	_c_holder=${_c_who%@*}
}

# One of: free, expired, live, dead, unverifiable.
claim_state() {
	[ -n "$2" ] || { echo free; return 0; }
	parse_claim "$2"
	if expired "$_c_expiry"; then echo expired; return 0; fi
	if [ "$_c_runtime" = "$(runtime "$1")" ]; then
		if holder_alive "$_c_holder"; then echo live; else echo dead; fi
	else
		echo unverifiable
	fi
}

# --- the lock --------------------------------------------------------------
#
# Rewriting a line in info is read-modify-write, so two agents can both see a
# free ticket and both write their pid, with the loser never finding out.
# mkdir is the atomic primitive that prevents it: it fails if the directory
# exists. The lock holds a pid so a crashed holder can be detected and broken
# rather than wedging the ticket forever.

# lock <dir> [seconds]
#
# Without a budget this returns as soon as the lock is held by someone else.
# That is right for claiming — there is other work to pick up — and wrong for
# anything the caller cannot simply skip, like allocating a number, so those
# pass a budget and wait.
lock() {
	_lk_d=$1 _lk_t="$_lk_d/.lock.$$" _lk_n=0
	_lk_budget=${2:-0} _lk_waited=0

	# Write the pid FIRST, into a private file nobody else looks at, then
	# publish it with link(2). A hard link either appears whole or not at
	# all, so the moment .lock exists it already names its owner: there is
	# no instant where the lock is visible but anonymous. link() is also
	# the primitive that stays atomic over NFS, where O_EXCL historically
	# is not.
	printf '%s\n' "$$" > "$_lk_t" || return 1

	while [ "$_lk_n" -lt 100 ]; do
		_lk_n=$((_lk_n+1))
		if ln "$_lk_t" "$_lk_d/.lock" 2>/dev/null; then
			rm -f "$_lk_t"
			return 0
		fi
		_lk_owner=""
		[ -r "$_lk_d/.lock" ] && read -r _lk_owner < "$_lk_d/.lock" 2>/dev/null || true
		if [ -z "$_lk_owner" ]; then
			# Should be unreachable now that publishing is atomic. Kept
			# because the cost of being wrong is two writers: an empty
			# lock is treated as in-flight, never as abandoned.
			continue
		fi
		if kill -0 "$_lk_owner" 2>/dev/null; then
			# A live holder. Wait if we were given a budget: the
			# lock is held for a few syscalls, so a short sleep
			# almost always clears it.
			if [ "$_lk_waited" -lt "$_lk_budget" ]; then
				sleep 0.05 2>/dev/null || sleep 1
				_lk_waited=$((_lk_waited + 1))
				_lk_n=0
				continue
			fi
			rm -f "$_lk_t"
			return 1
		fi
		rm -f "$_lk_d/.lock"                           # a dead one: break it
	done
	rm -f "$_lk_t"
	return 1
}

unlock() { rm -f "$1/.lock"; }

# Replace one line of a file, via a temp file and a rename. Callers hold the
# lock; the rename keeps a crash mid-write from leaving a truncated info.
set_line() {
	_sl_f=$1 _sl_n=$2 _sl_v=$3 _sl_t="$1.$$"
	awk -v n="$_sl_n" -v v="$_sl_v" 'NR==n{print v; next}{print}' "$_sl_f" > "$_sl_t"
	mv "$_sl_t" "$_sl_f"
}

# Fields are lines 4 up to the first blank line, or the end of the file.
# The body is everything after that blank line. Nothing records where either
# begins: the body ends at EOF, and the field boundary sits ahead of the body
# so body content can never reach it.

get_field() {
	awk -v k="$2" '
		NR <= 3 { next }
		$0 == "" { exit }
		index($0, k ":") == 1 { sub("^" k ": *", ""); print; exit }
	' "$1"
}

# Replace a field if present, otherwise append it to the field block.
# Callers hold the lock.
set_field() {
	_sf_f=$1 _sf_k=$2 _sf_v=$3 _sf_t="$1.$$"
	awk -v k="$_sf_k" -v v="$_sf_v" '
		NR <= 3 { print; next }
		!past && $0 == "" {
			if (!hit) print k ": " v
			past = 1; print; next
		}
		!past && index($0, k ":") == 1 { print k ": " v; hit = 1; next }
		{ print }
		END { if (!past && !hit) print k ": " v }
	' "$_sf_f" > "$_sf_t"
	mv "$_sf_t" "$_sf_f"
}

get_body() { awk 'b { print } !b && $0 == "" { b = 1 }' "$1"; }

# Everything wrong with one info file as a file: the three structural lines,
# the field block, and required fields. One finding per line, each prefixed
# with a label — the ticket number for check, the ticket being saved for
# edit. Both ask the same question, so it is written once.
#
# Nothing here looks outside the file. Dependencies, the registry and cycles
# are facts about the tracker, and check owns those.
info_faults() {
	_if_r=$1 _if_f=$2 _if_n=$3
	sed -n 1p "$_if_f" | grep -q '^claim:' ||
		printf '%s: line 1 is not claim:\n' "$_if_n"
	sed -n 2p "$_if_f" | grep -q '^needs:' ||
		printf '%s: line 2 is not needs:\n' "$_if_n"
	sed -n 3p "$_if_f" | grep -q '^title: .' ||
		printf '%s: line 3 is not a title\n' "$_if_n"

	# Everything between there and the first blank must be a field the
	# schema declares. A stray line here is usually a body that lost its
	# blank separator.
	_if_decl=$(schema_fields "$_if_r")
	awk 'NR>3 { if ($0 == "") exit; print }' "$_if_f" | while read -r _if_l; do
		case $_if_l in
		*:*) _if_k=${_if_l%%:*} ;;
		*)   printf "%s: '%s' is not a field\n" "$_if_n" "$_if_l"; continue ;;
		esac
		printf '%s\n' "$_if_decl" | grep -qx "$_if_k" ||
			printf "%s: field '%s' is not in schema.md\n" "$_if_n" "$_if_k"
	done

	schema_required "$_if_r" | while read -r _if_req; do
		[ -n "$_if_req" ] || continue
		awk -v k="$_if_req" 'NR>3 { if ($0=="") exit; if (index($0, k ":")==1) found=1 }
			END { exit !found }' "$_if_f" ||
			printf "%s: required field '%s' is missing\n" "$_if_n" "$_if_req"
	done
}

# Replace the body — everything after the blank line that ends the fields —
# with the text in $2, or drop it entirely if that is empty. The header and
# the field block are copied through untouched. Callers hold the lock.
set_body() {
	_sb_f=$1 _sb_v=$2 _sb_t="$1.$$"
	awk 'NR>3 && $0 == "" { exit } { print }' "$_sb_f" > "$_sb_t"
	[ -n "$_sb_v" ] && printf '\n%s\n' "$_sb_v" >> "$_sb_t"
	mv "$_sb_t" "$_sb_f"
}

# Add to the body, leaving what is there. This is the operation the format is
# built around — nothing records where a body ends, so appending is appending
# — and it is a blank line and a cat even when done by hand. Callers hold the
# lock.
append_body() {
	_ab_f=$1 _ab_v=$2
	[ -n "$_ab_v" ] || return 0
	printf '\n%s\n' "$_ab_v" >> "$_ab_f"
}

# --- claim / release -------------------------------------------------------

cmd_claim() {
	[ $# -eq 1 ] || die 'usage: pidly claim <number>'
	_r=$(root); _d=$(ticket_dir "$_r" "$1")

	# An agent with no reachable process table has no other liveness
	# signal, so a lease is not optional for it.
	if [ -n "${PIDLY_AGENT:-}" ] && [ -z "${PIDLY_LEASE:-}" ]; then
		die 'PIDLY_AGENT requires PIDLY_LEASE: nothing else can show it is alive'
	fi

	# needs blocks starting, so refuse before taking the lock: a blocked
	# ticket is not claimable regardless of who else is asking.
	_needs=$(sed -n '2s/^needs: *//p' "$_d/info")
	if [ -n "$_needs" ]; then
		_open=""
		_m=$(map "$_r")
		for _dep in $_needs; do
			_dp=$(printf '%s\n' "$_m" | awk -v n="$_dep" '$1==n{print $2; exit}')
			[ -n "$_dp" ] || die "$1 needs $_dep, which does not exist"
			in_closed "$_r" "$_dp" || _open="$_open $_dep"
		done
		[ -z "$_open" ] || die "$1 is blocked by open tickets:$_open"
	fi

	lock "$_d" || die "$1 is being modified by another process"
	_held=$(sed -n '1s/^claim://p' "$_d/info")
	_state=$(claim_state "$_r" "$_held")
	case $_state in
	free|expired) ;;
	live)         unlock "$_d"; die "$1 is held by $_held, which is running" ;;
	dead)         unlock "$_d"
	              die "$1 is held by $_held, which is gone — 'pidly reap' clears it" ;;
	unverifiable) unlock "$_d"
	              die "$1 is held by $_held, which this machine cannot check" ;;
	esac

	_who=$(holder "$_r")
	if [ -n "${PIDLY_LEASE:-}" ]; then
		_who="$_who $(lease_expiry "$PIDLY_LEASE")"
	fi
	set_line "$_d/info" 1 "claim:$_who"
	unlock "$_d"
	if [ "$_state" = expired ]; then
		printf '%s claimed by %s (previous lease had expired)\n' "$1" "$_who"
	else
		printf '%s claimed by %s\n' "$1" "$_who"
	fi

	# The point of a handoff is that the next agent sees it without having
	# to know it is there.
	_hand=$(get_field "$_d/info" handoff)
	[ -n "$_hand" ] && printf 'handoff: %s\n' "$_hand"
	return 0
}

cmd_release() {
	_note=""
	while [ $# -gt 0 ]; do
		case $1 in
		-m) [ $# -ge 2 ] || die 'usage: pidly release [-m note] <number>'
		    _note=$2; shift 2 ;;
		-*) die "unknown option $1" ;;
		*)  break ;;
		esac
	done
	[ $# -eq 1 ] || die 'usage: pidly release [-m note] <number>'
	case $_note in
	*"
"*) die 'a handoff note must be one line; put anything longer in the body' ;;
	esac
	_r=$(root); _d=$(ticket_dir "$_r" "$1")

	lock "$_d" || die "$1 is being modified by another process"
	_held=$(sed -n '1s/^claim://p' "$_d/info")
	[ -n "$_held" ] || { unlock "$_d"; die "$1 is not claimed"; }

	# You may only release what you hold. Anything else — including a claim
	# left behind by a dead local agent — is reap's job, which keeps
	# clearing someone else's claim behind an explicit command.
	parse_claim "$_held"
	_mine=$(holder "$_r")
	if [ "$_c_who" != "$_mine" ]; then
		unlock "$_d"
		case $(claim_state "$_r" "$_held") in
		dead) die "$1 is held by $_c_who, which is gone — 'pidly reap' clears it" ;;
		unverifiable)
		      die "$1 is held by $_c_who, which this machine cannot check" ;;
		*)    die "$1 is held by $_c_who, not by you" ;;
		esac
	fi
	set_line "$_d/info" 1 'claim:'
	[ -n "$_note" ] && set_field "$_d/info" handoff "$_note"
	unlock "$_d"
	printf '%s released\n' "$1"
	return 0
}

cmd_status() {
	[ $# -eq 1 ] || die 'usage: pidly status <number>'
	_r=$(root); _d=$(ticket_dir "$_r" "$1")
	_held=$(sed -n '1s/^claim://p' "$_d/info")
	_state=$(claim_state "$_r" "$_held")
	if [ "$_state" = free ]; then
		printf '%s\tunclaimed\n' "$1"
	else
		parse_claim "$_held"
		printf '%s\t%s\tholder %s' "$1" "$_state" "$_c_holder"
		[ -n "$_c_expiry" ] && printf '\tlease until %s' "$_c_expiry"
		printf '\n'
	fi
	_hand=$(get_field "$_d/info" handoff)
	[ -n "$_hand" ] && printf 'handoff: %s\n' "$_hand"
	return 0
}

# --- reap ------------------------------------------------------------------
#
# Clearing someone else's claim is the one destructive thing in the tracker,
# so it is a command of its own rather than something check or claim does on
# the way past. What it will clear is exactly the dead state: our runtime, so
# the process table is one we can read, and the process demonstrably absent.
#
# Not live, obviously. Not unverifiable — another machine's pid says nothing
# here, and treating silence as death is how two agents end up on one ticket.
# Not expired either: a lapsed lease is already takeable, so claim handles it
# and reap has nothing to add.
#
# Locks are not its business. A lock names a local pid and lock() breaks a
# dead one on the next attempt, so a stale lock heals itself.

# Clear one dead claim. Prints what it cleared; returns 1, silently, if the
# claim is anything else. Callers decide whether that is worth saying.
reap_one() {
	_rp_r=$1 _rp_d=$2 _rp_n=$3
	lock "$_rp_d" 100 || die "$_rp_n is being modified by another process"
	# Re-read under the lock. Between the scan and here the holder may have
	# released it, or a new agent may have taken it — and that one is alive.
	_rp_h=$(sed -n '1s/^claim://p' "$_rp_d/info")
	if [ "$(claim_state "$_rp_r" "$_rp_h")" != dead ]; then
		unlock "$_rp_d"
		return 1
	fi
	set_line "$_rp_d/info" 1 'claim:'
	unlock "$_rp_d"
	parse_claim "$_rp_h"
	printf '%s: cleared the claim by %s, which is gone\n' "$_rp_n" "$_c_holder"
	return 0
}

cmd_reap() {
	[ $# -le 1 ] || die 'usage: pidly reap [number]'
	_r=$(root)

	# Named ticket: say why nothing happened, since the caller asked about
	# this one and a silent success would read as "cleared".
	if [ $# -eq 1 ]; then
		_d=$(ticket_dir "$_r" "$1")
		_held=$(sed -n '1s/^claim://p' "$_d/info")
		parse_claim "$_held"
		case $(claim_state "$_r" "$_held") in
		dead) reap_one "$_r" "$_d" "$1" ||
			printf '%s: the claim was gone before it could be cleared\n' "$1" ;;
		free) die "$1 is not claimed" ;;
		live) die "$1 is held by $_c_holder, which is running" ;;
		expired)
		      die "$1 has an expired lease, which is already takeable — claim it" ;;
		unverifiable)
		      die "$1 is held by $_c_holder, which this machine cannot check — a claim you cannot verify is not a dead one" ;;
		esac
		return 0
	fi

	# A sweep. Closed tickets included: a dead claim left on finished work
	# is still something check reports, so reap has to be able to clear it.
	_rc="${TMPDIR:-/tmp}/pidly.reap.$$"
	: > "$_rc"
	map "$_r" | while read -r _num _path; do
		[ -n "$_num" ] || continue
		case $_num in *[!0-9]*) continue ;; esac
		[ -f "$_path/info" ] || continue
		[ "$(claim_state "$_r" "$(sed -n '1s/^claim://p' "$_path/info")")" = dead ] ||
			continue
		reap_one "$_r" "$_path" "$_num" >> "$_rc" || true
	done
	if [ -s "$_rc" ]; then
		cat "$_rc"
		printf '%s claim(s) cleared\n' "$(wc -l < "$_rc" | tr -d ' ')"
	else
		printf 'nothing to reap\n'
	fi
	rm -f "$_rc"
	return 0
}

# --- edit ------------------------------------------------------------------
#
# The body is the part of a ticket nothing can derive: it is what the work
# was, and after 19 it is where results land too. Editing it by hand is an
# editor, or a cat >> — this command is that plus two things a hand-edit does
# not get: the lock, so an edit and a claim landing together cannot lose each
# other, and a structural read of the file before it replaces the original.
#
# It is not a correctness requirement. It was one while desc: recorded where
# the body ended, because a hand-edit could leave that line lying; 20 removed
# the derived data, and with it the only thing edit had to keep honest.

cmd_edit() {
	_mode=editor
	while [ $# -gt 0 ]; do
		case $1 in
		-a|--append) _mode=append; shift ;;
		-b|--body)   _mode=body; shift ;;
		-*) die "unknown option $1" ;;
		*)  break ;;
		esac
	done
	[ $# -eq 1 ] || die 'usage: pidly edit [-a|-b] <number>'
	_r=$(root); _d=$(ticket_dir "$_r" "$1"); _f="$_d/info"

	if [ "$_mode" = editor ]; then
		# vi with nothing to talk to is a way to hang a script, and an
		# agent that wanted an editor did not want one.
		[ -t 0 ] || [ -n "${VISUAL:-}${EDITOR:-}" ] ||
			die 'no terminal and no $EDITOR: use -b or -a to edit from stdin'
		edit_in_editor "$_r" "$_d" "$1"
		return 0
	fi

	# Reading stdin whole, rather than streaming it into the file, keeps the
	# window in which info is half-written down to the mv. A body is prose.
	_text=$(cat)
	lock "$_d" 100 || die "$1 is being modified by another process"
	if [ "$_mode" = append ]; then
		append_body "$_f" "$_text"
	else
		set_body "$_f" "$_text"
	fi
	unlock "$_d"
	printf '%s updated\n' "$1"
	return 0
}

edit_in_editor() {
	_ee_r=$1 _ee_d=$2 _ee_n=$3 _ee_f="$2/info"
	_ee_ed=${VISUAL:-${EDITOR:-vi}}
	_ee_draft="${TMPDIR:-/tmp}/pidly.$_ee_n.$$"
	cat "$_ee_f" > "$_ee_draft"
	_ee_was=$(cksum < "$_ee_f")

	# The editor runs outside the lock. A lock held for the length of a
	# human edit blocks every claim on that ticket for as long as the
	# session lasts, and a session that never ends leaves one behind. The
	# comparison below is what that costs: instead of excluding a writer,
	# we notice one.
	$_ee_ed "$_ee_draft" ||
		{ rm -f "$_ee_draft"; die "$_ee_n was not written: the editor failed"; }

	if [ "$(cksum < "$_ee_draft")" = "$_ee_was" ]; then
		rm -f "$_ee_draft"
		printf '%s unchanged\n' "$_ee_n"
		return 0
	fi

	# A saved file that is no longer a ticket is the one thing an editor
	# makes easy — a deleted header line, a field that lost its colon, a
	# body that lost the blank line in front of it. The draft is kept: it
	# is the user's work, and it is the only copy of it.
	_ee_bad=$(info_faults "$_ee_r" "$_ee_draft" "$_ee_n")
	if [ -n "$_ee_bad" ]; then
		printf '%s\n' "$_ee_bad" >&2
		die "$_ee_n was not written; your edit is in $_ee_draft"
	fi

	lock "$_ee_d" 100 || die "$_ee_n is being modified by another process"
	if [ "$(cksum < "$_ee_f")" != "$_ee_was" ]; then
		unlock "$_ee_d"
		die "$_ee_n changed while the editor was open; your edit is in $_ee_draft"
	fi
	_ee_t="$_ee_f.$$"
	cat "$_ee_draft" > "$_ee_t"
	mv "$_ee_t" "$_ee_f"
	unlock "$_ee_d"
	rm -f "$_ee_draft"
	printf '%s updated\n' "$_ee_n"
	return 0
}

# --- close / reopen --------------------------------------------------------
#
# Both commands are moves and nothing else. Neither writes to an info file,
# because there is no status field to keep in step: state is the path, so
# moving the directory is the whole operation.

# A ticket is closed when it sits in its container's c/ — that is, when its
# immediate parent directory is named c. Not "the path contains /c/": that is
# also true of an open child of a closed parent, which is the broken state
# check reports rather than a ticket to treat as finished.
is_closed() { case $(dirname "$1") in */c) return 0 ;; *) return 1 ;; esac; }

# Numbered directories sitting directly in a ticket — its open children. A
# finished child is in the ticket's c/, so it is not one of these.
open_children() {
	for _oc in "$1"/*/; do
		[ -d "$_oc" ] || continue
		_oc=${_oc%/}; _oc=${_oc##*/}
		case $_oc in ''|*[!0-9]*) continue ;; esac
		printf '%s\n' "$_oc"
	done
}

cmd_close() {
	[ $# -eq 1 ] || die 'usage: pidly close <number>'
	_r=$(root); _d=$(ticket_dir "$_r" "$1")
	is_closed "$_d" && die "$1 is already closed"

	# An open child in a finished tree is the one thing the layout rules
	# out, and the parent is the only place that can refuse it.
	_kids=$(open_children "$_d" | tr '\n' ' ')
	[ -z "$_kids" ] || die "$1 has open children: ${_kids%% } — close them first"

	_cdir=$(dirname "$_d")/c
	mkdir -p "$_cdir"
	mv "$_d" "$_cdir/"
	printf '%s closed\n' "$1"
	return 0
}

cmd_reopen() {
	[ $# -eq 1 ] || die 'usage: pidly reopen <number>'
	_r=$(root)
	# Closed, or open inside a closed ancestor: either way there is a c/
	# between the ticket and the surface, and lifting those out is what
	# reopening means. A ticket with none of them is already open.
	in_closed "$_r" "$(ticket_dir "$_r" "$1")" || die "$1 is already open"

	# Outermost first. A closed ancestor holding live work is exactly what
	# the cascade exists to prevent, so each pass re-locates the ticket and
	# lifts the highest closed level out — one mv per level, and the state
	# is consistent between any two of them.
	while :; do
		_d=$(ticket_dir "$_r" "$1")
		in_closed "$_r" "$_d" || break
		_rel=${_d#"$_r"/}
		_head=${_rel%%c/*}
		_seg=${_rel#*c/}; _seg=${_seg%%/*}
		mv "$_r/${_head}c/$_seg" "$_r/$_head$_seg"
		# An emptied c/ is what a person would have been left with too;
		# removing it keeps the tree readable and cannot lose anything,
		# since rmdir refuses a directory that still holds work.
		rmdir "$_r/${_head}c" 2>/dev/null || true
		printf '%s reopened\n' "$_seg"
	done
	return 0
}

# --- agent instructions ----------------------------------------------------
#
# Written into AGENTS.md (or equivalent) between markers, so re-running
# replaces the block instead of appending a second copy, and anything a human
# wrote around it survives.

AGENTS_BEGIN='<!-- pidly:begin -->'
AGENTS_END='<!-- pidly:end -->'

# The reference that ships with a tracker. Larger than the AGENTS.md block
# and smaller than the design document, which stays in the pidly repo and is
# not available to projects that merely use pidly. Everything an agent needs
# in order to act correctly belongs here; everything explaining *why* the
# format is shaped this way belongs in the design document.

guide_text() {
	cat <<'GUIDE'
# .pidly

How this tracker works. Generated by `pidly agents` — edit the tracker, not
this file. Read it when you need a rule you do not already know; the summary
in AGENTS.md covers the common path.

## Shape

A ticket is a **directory**. Its name is its number. `info` inside it is what
is known about it. Nesting a ticket inside another makes it a subtask.

**State is location.** A ticket is open if it sits directly in its container,
closed if it sits in that container's `c/`. Nothing else records state.

```
.pidly/
  schema.md        project fields
  7/
    info           ticket 7, open
    12/
      info         ticket 12, an open subtask of 7
    c/
      13/info      ticket 13, a finished subtask of 7
  c/
    4/info         ticket 4, finished, top level
```

Numbers are unique across the whole tracker and **never reused**. A path is
made of ticket numbers and `c`, so `.pidly/7/12/` is ticket 12 under 7.

## The info file

```
claim:                     1  empty, or who holds it
needs: 3 8                 2  tickets that must close before this starts
title: Short human title   3
effort: M                  4  project fields, defined in schema.md
handoff: where I got to    5  ...as many as the schema declares, or none
                           6  one blank line
The body, from here        7  ...to the end of the file
```

Read only as far as you need:

| want | read |
|---|---|
| can I take this? | `sed -n 1,2p info` |
| a listing line | `sed -n 3p info` |
| project fields | `awk 'NR>3 { if ($0=="") exit; print }' info` |
| the body | `awk 'b { print } !b && $0=="" { b=1 }' info` |

Nothing records where the body starts or ends. It runs to the end of the
file, and the fields stop at the first blank line — which is ahead of the
body, so nothing you write in a body can be mistaken for the boundary.
Appending to a body needs no bookkeeping.

## Finding work

```sh
pidly list        # ready work: unclaimed and unblocked
pidly list -a     # every open ticket, with its state
pidly tree        # the hierarchy, closed tickets marked [x]
pidly check       # report anything wrong; changes nothing
```

By hand, or when pidly is not installed:

```sh
find .pidly -type d -name c -prune -o -name info -print
```

`-prune` is what keeps this from walking finished work. A ticket is
**takeable** when line 1 is empty and every number on line 2 resolves to a
directory whose path contains `/c/`.

Resolve those numbers with **one traversal**, not one `find` per dependency:
build a number-to-path map from a single `find .pidly -type d` and answer
every lookup from it. On a 2000-ticket tree the difference is 26.5s against
2.0s.

## Claiming

```sh
PIDLY_PID=$$ pidly claim 7     # $$ is your agent's process, not the CLI's
pidly status 7
pidly release 7
```

Export `PIDLY_PID` once for the life of your agent. A release only succeeds
for the process that made the claim, so claiming and releasing from separate
invocations have to agree on who you are.

A claim records `<pid>.<starttime>@<runtime>`. The start time is what stops a
recycled pid from looking like the original process; the runtime is boot id,
uid and pid namespace, so a pid is only ever checked against the process
table it came from.

If you have no process anyone here can check — a cloud session, a CI job —
claim with a lease and renew by claiming again before it expires:

```sh
PIDLY_AGENT=$SESSION_ID PIDLY_LEASE=2h pidly claim 7
```

A claim resolves to one of:

| state | meaning |
|---|---|
| `expired` | the lease ran out; anyone may take it |
| `live` | same runtime, process is there |
| `dead` | same runtime, process positively is not |
| `unverifiable` | another runtime, lease still good |

Only `free` and `expired` can be claimed. Only `dead` can be cleared:

```sh
pidly reap 7      # clear a dead claim on one ticket, and say why if it will not
pidly reap        # sweep the whole tracker, closed work included
```

**Never treat `unverifiable` as dead** — that puts two agents on one ticket,
and `reap` will not do it for you. It refuses a live claim, an unverifiable
one, and an expired lease, which needs no clearing because it is already
takeable. A stale `.lock` needs no clearing either: it names a local process,
and the next command to want the lock breaks it.

Claiming rewrites line 1, so it is the one operation that is not safe to do
by hand while other agents are running: `pidly claim` serializes it behind a
lock. Everything else here is safe with `find`, `sed` and `mv`.

### Handing off

If you stop before finishing, say where you got to:

```sh
pidly release -m "Parser works; lexer still fails on nested quotes." 7
```

That lands in the `handoff` field, and `pidly claim` prints it to whoever
picks the ticket up next. One line — anything longer belongs in the body. It
is overwritten by the next handoff, not accumulated, so it always describes
the most recent stop.

## Creating

A project with no tracker starts one with `pidly init`, which seeds this
file, `schema.md` and the ignore rules. Re-running it refreshes the generated
files and leaves `schema.md` alone.

The next number is the **highest number anywhere in the tracker plus one**,
counting closed tickets. There is no counter file. Make the directory inside
the parent, or in `.pidly/` for a top-level ticket, and write the four header
lines:

```sh
mkdir .pidly/7/14
printf 'claim:\nneeds:\ntitle: %s\n\n%s\n' "Do the thing" "Why." \
  > .pidly/7/14/info
printf '%s %s\n' "$(head -c8 /dev/urandom | od -An -tx1 | tr -d ' ')" \
  "Do the thing" > .pidly/.n/14
```

That last file is the **number registry**. It is what makes two branches
issuing the same number a merge conflict instead of a silent duplicate, so a
ticket created by hand needs one too. `pidly init` backfills any that are
missing, and `pidly new` writes it for you along with the lock that stops two
agents picking the same number.

## Editing

```sh
pidly edit 7                 # $EDITOR on info, read for structure before it lands
pidly edit -b 7 < body.md    # replace the body from stdin
pidly edit -a 7 <<'EOF'      # append to it: findings, results, where you got to
Reviewed the parser: the lexer loses nested quotes at depth 2.
EOF
```

By hand it is your editor, or `cat >> .pidly/7/info` — nothing records where
a body starts or ends, so appending is appending. What the command adds is the
lock, so an edit and a claim landing together cannot lose each other, and a
refusal to install a saved file that is no longer a ticket: a missing header
line, a field without a colon, a body that lost the blank line in front of
it. A rejected edit is kept, and the path is printed.

Fields are lines, so a one-off is `sed`; `pidly release -m` is the one that
matters and it writes `handoff` for you.

## Delegating to a subagent

A subagent usually shares its parent's process — under Claude Code, a Bash
call from a subagent reports the same `CLAUDE_PID` as the lead agent. So a
pid cannot tell them apart: two claims, one pid, both live. **A subagent
claims as an agent, with a lease**, the same way a cloud agent does:

```sh
PIDLY_AGENT=sub-review-parser PIDLY_LEASE=1h pidly claim 19
```

The lead agent creates the ticket and passes the number down, because it
writes the subagent's prompt:

```sh
pidly new -p 7 "Review the parser changes"     # prints 19
# ...then include "your ticket is 19" in the subagent's instructions
```

When the subagent finishes it leaves a handoff and releases; the lead reads
that and decides whether to close. If the subagent dies, the lease expires
and the ticket frees itself.

**Write down what the subagent found before the context is gone.** Its
output is otherwise ephemeral: it lands in the lead agent's context, gets
summarised, and disappears. Findings go in the body of the ticket the
subagent worked on. Appending to a body is just appending.

If the result is a standalone artifact — a review, a benchmark — put it
where artifacts live in the repo and reference the path from the body. It is
usually about the code rather than about the ticket, so it belongs next to
the code, where everyone finds it and where closing the ticket does not
archive it.

Not a ticket of its own. One created and closed in the same breath is a log
entry wearing a ticket costume, and it spends a number that can never be
reused.

**Not every subagent deserves a ticket.** A lookup or a search does not.
Numbers are never reused and tickets are never deleted, so a ticket per
subagent call is permanent noise — and an open child blocks its parent from
closing, so it does active harm. Open one when the work is a unit you would
want to see in the tracker tomorrow.

## Closing and reopening

Closing is a move into the container's `c/`:

```sh
pidly close 12    # or: mkdir -p .pidly/7/c && mv .pidly/7/12 .pidly/7/c/
pidly reopen 12
```

A ticket **cannot close while it has children outside its own `c/`**. That is
what keeps a finished tree from containing live work.

`reopen` moves it back, and **cascades upward**: if a closed ancestor holds
it, that ancestor reopens too, one move per level. If a subtask needs redoing
then its parent is not finished either. Reopening does not cascade downward,
and does not reopen tickets that `needs` it.

Reopen also takes a ticket that is *already open* but sits inside a closed
ancestor — a state a hand-run `mv` can leave behind, and one `check` reports.
The cascade is its repair.

## Rules that will bite you

- **Never delete a ticket.** Numbers are never reused, and deleting one lets
  its number be issued again to something else. Close it instead.
- **`needs` holds numbers, never paths.** A number is permanent; a path
  changes every time a ticket is closed or re-parented.
- **Parents and dependencies are different things.** `needs` blocks starting;
  children block closing. Neither implies the other, and a parent is never an
  implicit dependency of its own children.
- **Leave a handoff when you stop early.** A dropped claim with no note makes
  the next agent reconstruct your progress from the diff.
GUIDE
}

agents_block() {
	cat <<'BLOCK'
<!-- pidly:begin -->
## Issue tracking with pidly

Work lives in `.pidly/` as plain files. **Full rules: `.pidly/README.md`** —
read it before doing anything beyond the commands below.

A ticket is a directory; `info` inside it is what's known about it. The
directory name is its number, which never changes and is never reused.
**State is location**: open tickets sit directly in their container, closed
ones in that container's `c/`. Closing is a move.

```
.pidly/7/info        ticket 7, open
.pidly/7/12/info     ticket 12, an open subtask of 7
.pidly/7/c/13/info   ticket 13, finished
```

`info` is four header lines, then the body, then project fields:

```
claim:                1  empty, or who holds it
needs: 3 8            2  must be closed before this starts
title: Short title    3
effort: M             4  project fields, then a blank line,
                         then the body to the end of the file
```

```sh
# open tickets, never descending into finished work
find .pidly -type d -name c -prune -o -name info -print

# takeable = line 1 empty, and every number on line 2 resolves to a
# directory whose path contains /c/
sed -n 1,2p .pidly/7/info

PIDLY_PID=$$ pidly claim 7    # $$ is your process, not the CLI's
pidly status 7                # who holds it, and if that is checkable
pidly release 7
pidly release -m "Where I got to" 7   # if you stop before finishing

# no local process (cloud, CI)? claim with a lease and renew before it ends
PIDLY_AGENT=$SESSION_ID PIDLY_LEASE=2h pidly claim 7

# finish: move into the container's c/
pidly close 7                 # by hand: mkdir -p .pidly/c && mv .pidly/7 .pidly/c/
```

Claim before starting; release or close when done. Delegating real work to a
subagent? Open a child ticket and pass it the number — see the reference, and
note a subagent claims with `PIDLY_AGENT`, not a pid.

- **Never delete a ticket** — numbers are never reused. Close it.
- A ticket cannot close while it has children outside its own `c/`.
- A claim you cannot verify is not a dead one. Leave it alone.
<!-- pidly:end -->
BLOCK
}

cmd_agents() {
	_f=""
	case ${1:-} in
	-f) [ $# -eq 2 ] || die 'usage: pidly agents [-f FILE]'; _f=$2 ;;
	'') for _c in AGENTS.md CLAUDE.md GEMINI.md .cursorrules; do
		[ -f "$_c" ] && { _f=$_c; break; }
	    done
	    [ -n "$_f" ] || _f=AGENTS.md ;;
	*)  die 'usage: pidly agents [-f FILE]' ;;
	esac

	_r=$(root)
	guide_text > "$_r/README.md"

	if [ -f "$_f" ] && grep -qF "$AGENTS_BEGIN" "$_f"; then
		_t="$_f.pidly.$$"
		awk -v b="$AGENTS_BEGIN" -v e="$AGENTS_END" -v blk="$(agents_block)" '
			index($0, b) { print blk; skip = 1; next }
			index($0, e) { skip = 0; next }
			!skip        { print }
		' "$_f" > "$_t"
		mv "$_t" "$_f"
		printf 'updated the pidly section in %s, and %s/README.md\n' "$_f" "$_r"
	else
		[ -f "$_f" ] && [ -s "$_f" ] && printf '\n' >> "$_f"
		agents_block >> "$_f"
		printf 'added a pidly section to %s, and wrote %s/README.md\n' "$_f" "$_r"
	fi
}

# --- the number registry ---------------------------------------------------
#
# .pidly/.n/<number> is created when a number is issued and never modified.
# It holds a nonce and the title.
#
# Its job is to make a collision that git would otherwise merge silently into
# one that git refuses. Two branches cannot see each other while they
# allocate, so the lock cannot help: branch A creating .pidly/5 and branch B
# creating .pidly/7/5 merge cleanly and leave two tickets numbered 5. With a
# registry, both write .pidly/.n/5 with different content, and the merge stops
# with an add/add conflict naming the number.
#
# This detects rather than prevents. Only a non-coordinating id — a hash, a
# timestamp — could prevent it, and that costs the readable number the whole
# format is built around. Being told at merge time, before anything is built
# on the bad state, is the trade.
#
# It also means a number is never reissued even if a ticket directory is
# deleted by hand, and gives a dangling `needs: 5` something to say about
# what 5 was.

nonce() {
	if [ -r /dev/urandom ]; then
		LC_ALL=C tr -dc 'a-z0-9' < /dev/urandom 2>/dev/null | dd bs=1 count=8 2>/dev/null
	else
		printf '%s%s' "$$" "$(date +%s)"
	fi
}

registry_dir() { printf '%s/.n\n' "$1"; }

# Record that a number has been issued. Never overwrites: the content is what
# distinguishes two branches that took the same number.
register() {
	_rg_d=$(registry_dir "$1")
	mkdir -p "$_rg_d"
	[ -e "$_rg_d/$2" ] && return 0
	printf '%s %s\n' "$(nonce)" "$3" > "$_rg_d/$2"
}

registry_highest() {
	_rh_d=$(registry_dir "$1")
	[ -d "$_rh_d" ] || { echo 0; return 0; }
	ls "$_rh_d" 2>/dev/null | awk '{ if ($1+0 > m) m = $1+0 } END { print m+0 }'
}

# --- new -------------------------------------------------------------------

# Project fields the schema marks required, one per line. A ticket missing one
# is still readable — check reports it — but new stubs them so the ticket
# starts valid rather than starting wrong.
schema_required() {
	[ -f "$1/schema.md" ] || return 0
	awk -F'|' '
		/^[[:space:]]*\|/ {
			f = $2; r = $3
			gsub(/^[ \t]+|[ \t]+$/, "", f)
			gsub(/^[ \t]+|[ \t]+$/, "", r)
			if (f == "" || f == "field" || f ~ /^-+$/) next
			if (r == "yes") print f
		}' "$1/schema.md"
}

# The highest number issued: the greater of what the registry records and
# what the tree contains. Both are needed — the registry catches numbers whose
# ticket was deleted, and the tree catches tickets created by hand, which the
# format explicitly allows.
highest() {
	_hi_tree=$(map "$1" | awk '{ if ($1+0 > m) m = $1+0 } END { print m+0 }')
	_hi_reg=$(registry_highest "$1")
	if [ "$_hi_reg" -gt "$_hi_tree" ]; then printf '%s\n' "$_hi_reg"
	else printf '%s\n' "$_hi_tree"; fi
}

cmd_new() {
	_parent="" _needs=""
	while [ $# -gt 0 ]; do
		case $1 in
		-p) [ $# -ge 2 ] || die 'usage: pidly new [-p parent] [-n "3 8"] <title>'
		    _parent=$2; shift 2 ;;
		-n) [ $# -ge 2 ] || die 'usage: pidly new [-p parent] [-n "3 8"] <title>'
		    _needs=$2; shift 2 ;;
		-*) die "unknown option $1" ;;
		*)  break ;;
		esac
	done
	[ $# -eq 1 ] || die 'usage: pidly new [-p parent] [-n "3 8"] <title>'
	_title=$1
	case $_title in
	'') die 'a ticket needs a title' ;;
	*"
"*) die 'a title must be one line' ;;
	esac

	_r=$(root)

	if [ -n "$_parent" ]; then
		_pd=$(ticket_dir "$_r" "$_parent")
		# An open child inside a closed parent would put live work in a
		# finished tree, which is the one thing the layout rules out.
		in_closed "$_r" "$_pd" &&
			die "$_parent is closed — reopen it before adding children"
	else
		_pd=$_r
	fi

	for _dep in $_needs; do
		case $_dep in
		''|*[!0-9]*) die "needs takes ticket numbers, not '$_dep'" ;;
		esac
		ticket_dir "$_r" "$_dep" >/dev/null
	done

	# Scan before locking. A stale answer only costs a few extra mkdir
	# attempts, and it keeps the critical section down to those attempts
	# rather than a full traversal of the tracker.
	_n=$(highest "$_r")

	# mkdir only arbitrates between siblings, so two agents adding children
	# to different parents would otherwise both take the same number. 200
	# attempts at 50ms is ten seconds, far longer than any real contention.
	lock "$_r" 200 || die 'the tracker is busy; try again'
	while :; do
		_n=$((_n + 1))
		mkdir "$_pd/$_n" 2>/dev/null && break
		[ "$_n" -gt 1000000 ] && { unlock "$_r"; die 'cannot allocate a number'; }
	done
	register "$_r" "$_n" "$_title"
	unlock "$_r"

	{
		printf 'claim:\n'
		printf 'needs:%s\n' "${_needs:+ $_needs}"
		printf 'title: %s\n' "$_title"
		schema_required "$_r" | while read -r _f; do printf '%s:\n' "$_f"; done
		if [ ! -t 0 ]; then
			_body=$(cat)
			[ -n "$_body" ] && printf '\n%s\n' "$_body"
		fi
	} > "$_pd/$_n/info"

	printf '%s\t%s\n' "$_n" "$_pd/$_n/info"
}

# --- init ------------------------------------------------------------------

# The tracker's own ignore rules live inside .pidly, not in the repo root, so
# the tracker is self-contained: copying or deleting the directory does not
# leave stale entries behind in a file it does not own.
ignore_text() {
	cat <<'IGNORE'
# Transient locks, held for the duration of one command. A lock in a commit
# names a process on someone else's machine and can only mislead.
.lock
.lock.*

# Fallback checkout identity, used only where there is no boot id to derive a
# runtime from. It is per-machine by definition.
.id

# .n/ is deliberately NOT ignored. It is the number registry, and it only
# stops two branches issuing the same number if it is committed.
IGNORE
}

# The starting schema. The four header lines are structural and always
# present, so they are documented rather than declared; the table below them
# is the project's own, and starts with just the handoff field.
schema_text() {
	cat <<'SCHEMA'
# Ticket schema

Every ticket is a directory; its content is the file `info` inside it.
Four header lines are structural and always present, in this order:

| line | field | meaning |
|---|---|---|
| 1 | `claim:` | empty, or `<pid>.<starttime>@<runtime>`, or `<agent>@- <expiry>` |
| 2 | `needs:` | space-separated ticket numbers that must be closed first |
| 3 | `title:` | a human title, not the number |

Lines 4 onward are project fields from the table below, ending at the first
blank line. Everything after that blank line is the body, which runs to the
end of the file. Add your own rows; `pidly check` enforces them.

| field   | required | values                                |
|---------|----------|---------------------------------------|
| handoff | no       | one line: where the last agent got to |
SCHEMA
}

# The nearest .pidly at or above a directory, or nothing.
find_root() {
	_fr_d=$1
	while [ "$_fr_d" != / ]; do
		[ -d "$_fr_d/.pidly" ] && { printf '%s\n' "$_fr_d/.pidly"; return 0; }
		_fr_d=$(dirname "$_fr_d")
	done
	return 0
}

cmd_init() {
	[ $# -eq 0 ] || die 'usage: pidly init'
	_ir="$PWD/.pidly"

	if [ -d "$_ir" ]; then
		_fresh=no
	else
		# A tracker inside another tracker would be found by the outer
		# one's traversals, and its numbers would collide.
		_outer=$(find_root "$PWD")
		[ -n "$_outer" ] &&
			die "$_outer already tracks this directory; pidly does not nest"
		mkdir "$_ir" || die "cannot create $_ir"
		_fresh=yes
	fi

	# schema.md belongs to the project once it exists. Everything else here
	# is generated, so re-running init is a refresh rather than a reset.
	if [ -f "$_ir/schema.md" ]; then
		_schema=kept
	else
		schema_text > "$_ir/schema.md"
		_schema=written
	fi
	ignore_text > "$_ir/.gitignore"

	# Backfill the registry for a tracker that predates it, or for tickets
	# created by hand. Without an entry a number has no merge guard.
	mkdir -p "$(registry_dir "$_ir")"
	_added=0
	map "$_ir" | while read -r _num _path; do
		[ -e "$(registry_dir "$_ir")/$_num" ] && continue
		register "$_ir" "$_num" "$(sed -n '3s/^title: //p' "$_path/info" 2>/dev/null)"
		printf 'x\n' >> "$_ir/.backfilled.$$"
	done
	[ -f "$_ir/.backfilled.$$" ] &&
		{ _added=$(wc -l < "$_ir/.backfilled.$$"); rm -f "$_ir/.backfilled.$$"; }

	if [ "$_fresh" = yes ]; then
		printf 'created %s\n' "$_ir"
	else
		printf 'refreshed %s\n' "$_ir"
	fi
	printf 'schema.md %s, .gitignore written\n' "$_schema"
	[ "${_added:-0}" -gt 0 ] &&
		printf 'registered %s number(s) that had no entry\n' "$_added"
	cmd_agents "$@"
	return 0
}

# --- views -----------------------------------------------------------------

# Field names the schema declares, one per line.
schema_fields() {
	[ -f "$1/schema.md" ] || return 0
	awk -F'|' '
		/^[[:space:]]*\|/ {
			f = $2
			gsub(/^[ \t]+|[ \t]+$/, "", f)
			if (f == "" || f == "field" || f ~ /^-+$/) next
			if (f ~ /^[0-9]+$/) next          # the structural-lines table
			print f
		}' "$1/schema.md"
}

# "number<TAB>state<TAB>blockers<TAB>title" for every open ticket, computed
# from one traversal and the first three lines of each file. No bodies are
# read. state is ready, blocked or claimed.
survey() {
	_sv_r=$1
	map "$_sv_r" | awk -v root="$_sv_r" '
		# Relative to root, for the reason in in_closed().
		{ closed[$1] = (substr($2, length(root) + 2) ~ /(^|\/)c\//)
		  path[$1] = $2 }
		END {
			for (n in path) {
				if (closed[n]) continue
				f = path[n] "/info"
				claim = ""; needs = ""; title = ""
				getline claim < f
				getline needs < f
				getline title < f
				close(f)
				sub(/^claim:/, "", claim)
				sub(/^needs:[ ]?/, "", needs)
				sub(/^title:[ ]?/, "", title)
				blockers = ""
				k = split(needs, d, " ")
				for (i = 1; i <= k; i++)
					if (!(d[i] in path) || !closed[d[i]])
						blockers = blockers (blockers ? "," : "") d[i]
				state = blockers != "" ? "blocked" : (claim != "" ? "claimed" : "ready")
				# "-" rather than empty: tab is IFS whitespace, so a
				# shell read collapses two tabs into one and every
				# later field shifts left.
				printf "%s\t%s\t%s\t%s\n", n, state, blockers ? blockers : "-", title
			}
		}'
}

cmd_list() {
	_all=no
	case ${1:-} in
	-a|--all) _all=yes; shift ;;
	esac
	[ $# -eq 0 ] || die 'usage: pidly list [-a]'
	_r=$(root)
	survey "$_r" | sort -n | while IFS='	' read -r _n _st _bl _ti; do
		if [ "$_all" = no ]; then
			[ "$_st" = ready ] || continue
			printf '%-5s %s\n' "$_n" "$_ti"
		elif [ "$_st" = blocked ]; then
			printf '%-5s %-8s %s (needs %s)\n' "$_n" "$_st" "$_ti" "$_bl"
		else
			printf '%-5s %-8s %s\n' "$_n" "$_st" "$_ti"
		fi
	done
}

# Children under their parent, closed ones marked.
#
# Not recursive. A recursive shell function cannot hold loop state: POSIX
# shell has one variable namespace, so the inner call clobbers the outer
# one's cursor, and prefixing names per function does not help when the
# function collides with itself. Instead each ticket's path becomes a sort
# key of zero-padded ancestor numbers, which puts parents before children
# and siblings in numeric order in a single pass.
#
# The sort runs under LC_ALL=C. A locale-aware collation ignores the "/"
# between segments, which puts a child ahead of its own parent.
cmd_tree() {
	[ $# -eq 0 ] || die 'usage: pidly tree'
	_r=$(root)
	map "$_r" | awk -v root="$_r" '
		{
			rel = $2
			sub("^" root "/", "", rel)
			n = split(rel, seg, "/")
			key = ""; depth = 0; closed = 0
			for (i = 1; i <= n; i++) {
				if (seg[i] == "c") { closed = 1; continue }
				key = key sprintf("%09d/", seg[i])
				depth++
			}
			f = $2 "/info"
			title = ""
			getline title < f; getline title < f; getline title < f
			close(f)
			sub(/^title:[ ]?/, "", title)
			printf "%s\t%d\t%s\t%s\t%s\n", key, depth, closed, $1, title
		}' | LC_ALL=C sort | while IFS='	' read -r _k _depth _closed _num _title; do
		_ind=''
		_i=1
		while [ "$_i" -lt "$_depth" ]; do _ind="$_ind  "; _i=$((_i + 1)); done
		[ "$_closed" = 1 ] && _mk='[x]' || _mk='[ ]'
		printf '%s%s %-4s %s\n' "$_ind" "$_mk" "$_num" "$_title"
	done
}

# --- check -----------------------------------------------------------------
#
# Reports; never modifies. That is what lets it run in CI and what lets
# anyone run it without thinking about what it might do.

# Findings go to a file, not a variable. Almost every check below runs
# inside a pipeline, and a pipeline's commands run in subshells, so a counter
# incremented there never reaches this one.
flag() { printf '%s\n' "$*" >> "$PIDLY_REPORT"; }

cmd_check() {
	[ $# -eq 0 ] || die 'usage: pidly check'
	_r=$(root)
	PIDLY_REPORT="${TMPDIR:-/tmp}/pidly.report.$$"
	export PIDLY_REPORT
	: > "$PIDLY_REPORT"
	_m=$(map "$_r")

	# One number, one ticket.
	printf '%s\n' "$_m" | awk '{print $1}' | sort | uniq -d | while read -r _d; do
		[ -n "$_d" ] || continue
		flag "$_d: issued to more than one ticket"
	done

	printf '%s\n' "$_m" | while read -r _num _path; do
		[ -n "$_num" ] || continue
		# A non-numeric directory is flagged by its parent below. Checking
		# it as a ticket would report the same fault three more times.
		case $_num in *[!0-9]*) continue ;; esac
		_f="$_path/info"

		[ -f "$_f" ] || { flag "$_num: no info file in $_path"; continue; }

		info_faults "$_r" "$_f" "$_num" | while read -r _fault; do
			flag "$_fault"
		done

		# Dependencies resolve.
		for _dep in $(sed -n '2s/^needs: *//p' "$_f"); do
			printf '%s\n' "$_m" | awk -v d="$_dep" '$1==d{f=1} END{exit !f}' ||
				flag "$_num: needs $_dep, which does not exist"
		done

		# A ticket holds its info, child tickets, c/ and attachments-free
		# directories only. Anything else is read as a phantom ticket.
		for _sub in "$_path"/*/; do
			[ -d "$_sub" ] || continue
			_sn=$(basename "$_sub")
			[ "$_sn" = c ] && continue
			case $_sn in
			''|*[!0-9]*) flag "$_num: '$_sn/' is neither a number nor c"
			             continue ;;
			esac
			# A numbered directory sitting here is an open child, and a
			# finished tree may not hold live work. Only the parent can
			# see this: the child's own path says c/ and looks closed.
			in_closed "$_r" "$_path" &&
				flag "$_num: closed, but child $_sn is open"
		done

		# Claims and locks whose holder is gone.
		_held=$(sed -n '1s/^claim://p' "$_f")
		case $(claim_state "$_r" "$_held") in
		dead) flag "$_num: claimed by $_held, which is gone" ;;
		esac
		if [ -e "$_path/.lock" ]; then
			_lo=""
			read -r _lo < "$_path/.lock" 2>/dev/null || true
			if [ -z "$_lo" ]; then
				flag "$_num: a lock with no owner"
			elif ! kill -0 "$_lo" 2>/dev/null; then
				flag "$_num: a lock held by $_lo, which is gone"
			fi
		fi
	done

	# The registry, both directions.
	printf '%s\n' "$_m" | while read -r _num _path; do
		[ -n "$_num" ] || continue
		case $_num in *[!0-9]*) continue ;; esac
		[ -e "$(registry_dir "$_r")/$_num" ] ||
			flag "$_num: no registry entry, so nothing stops a branch reusing it"
	done
	if [ -d "$(registry_dir "$_r")" ]; then
		ls "$(registry_dir "$_r")" 2>/dev/null | while read -r _e; do
			[ -n "$_e" ] || continue
			printf '%s\n' "$_m" | awk -v n="$_e" '$1==n{f=1} END{exit !f}' ||
				flag "registry has $_e with no ticket (deleted?)"
		done
	fi

	# Cycles, by peeling nodes with no unresolved dependency.
	printf '%s\n' "$_m" | while read -r _num _path; do
		[ -n "$_num" ] || continue
		case $_num in *[!0-9]*) continue ;; esac
		[ -f "$_path/info" ] || continue
		printf '%s %s\n' "$_num" "$(sed -n '2s/^needs: *//p' "$_path/info")"
	done | awk '
		{ node[$1] = 1; for (i = 2; i <= NF; i++) dep[$1] = dep[$1] " " $i }
		END {
			changed = 1
			while (changed) {
				changed = 0
				for (n in node) {
					if (done[n]) continue
					k = split(dep[n], d, " "); ok = 1
					for (i = 1; i <= k; i++)
						if (d[i] in node && !done[d[i]]) ok = 0
					if (ok) { done[n] = 1; changed = 1 }
				}
			}
			for (n in node) if (!done[n]) print n
		}' | sort -n | while read -r _c; do
		[ -n "$_c" ] || continue
		flag "$_c: in a needs cycle"
	done

	# The generated documents, against what would be generated now.
	_tmp="${TMPDIR:-/tmp}/pidly.check.$$"
	guide_text > "$_tmp"
	cmp -s "$_tmp" "$_r/README.md" ||
		flag "README.md is out of date — run 'pidly agents'"
	for _cand in AGENTS.md CLAUDE.md GEMINI.md .cursorrules; do
		[ -f "$_cand" ] || continue
		grep -qF "$AGENTS_BEGIN" "$_cand" || continue
		awk -v b="$AGENTS_BEGIN" -v e="$AGENTS_END" '
			index($0, b) { p = 1 } p { print } index($0, e) { exit }
		' "$_cand" > "$_tmp"
		agents_block | cmp -s - "$_tmp" ||
			flag "$_cand's pidly section is out of date — run 'pidly agents'"
	done
	rm -f "$_tmp"

	if [ -s "$PIDLY_REPORT" ]; then
		sort "$PIDLY_REPORT"
		printf '%s problem(s)\n' "$(wc -l < "$PIDLY_REPORT" | tr -d ' ')"
		rm -f "$PIDLY_REPORT"
		return 1
	fi
	rm -f "$PIDLY_REPORT"
	printf 'ok: %s tickets\n' "$(printf '%s\n' "$_m" | grep -c . || true)"
	return 0
}

# --- entry point -----------------------------------------------------------

usage() {
	cat >&2 <<'USAGE'
usage: pidly <command> [args]

  init           create .pidly here, or refresh what it generates
  new [-p N] [-n "3 8"] <title>
                 create a ticket, optionally under parent N, optionally
                 blocked on other tickets; body is read from stdin
  claim <n>      take ticket n
  release [-m note] <n>
                 give it back, optionally recording where you got to
  status <n>     who holds it, and whether that can be verified
  reap [n]       clear claims whose process is positively gone, one ticket or
                 the whole tracker; never a claim it cannot check
  edit [-a|-b] <n>
                 open it in $EDITOR; -b replaces the body from stdin, -a
                 appends to it
  close <n>      finish it: move it into its container's c/
  reopen <n>     move it back, reopening any closed ancestors
  list [-a]      takeable work; -a shows every open ticket with its state
  tree           the hierarchy, closed tickets marked [x]
  check          report anything wrong; changes nothing, nonzero if it finds
                 something, so it can run in CI
  agents [-f F]  write .pidly/README.md and a summary into AGENTS.md (or F),
                 replacing the summary if already present

environment:
  PIDLY_PID      the agent's process (default: $CLAUDE_PID, else $PPID).
                 Recorded with its start time, so a recycled pid is never
                 mistaken for it.
  PIDLY_AGENT    an agent with no local process — a cloud session, a CI job.
                 Requires PIDLY_LEASE: nothing else can show it is alive.
  PIDLY_LEASE    how long the claim is good for: 90s, 30m, 2h, 3d.

USAGE
	exit 2
}

[ $# -ge 1 ] || usage
cmd=$1; shift
case $cmd in
init)    cmd_init "$@" ;;
new)     cmd_new "$@" ;;
claim)   cmd_claim "$@" ;;
release) cmd_release "$@" ;;
status)  cmd_status "$@" ;;
reap)    cmd_reap "$@" ;;
edit)    cmd_edit "$@" ;;
close)   cmd_close "$@" ;;
reopen)  cmd_reopen "$@" ;;
list)    cmd_list "$@" ;;
tree)    cmd_tree "$@" ;;
check)   cmd_check "$@" ;;
agents)  cmd_agents "$@" ;;
*)       usage ;;
esac
