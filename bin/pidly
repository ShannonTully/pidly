#!/bin/sh
# pidly — a file-based issue tracker
#
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Shannon Tully
#
# This line rides along with the script. pidly is meant to be copied into a
# repository that wants it, and a copy that leaves the LICENSE file behind
# still says what it is and who wrote it.
#
# Every command here is something a person could do with mkdir, mv and an
# editor, leaving the repository byte-identical. The exception is claiming,
# which needs the lock to be safe while other agents are running.

set -eu

die() { printf 'pidly: %s\n' "$*" >&2; exit 1; }

# A newline, for the lookups that are parameter expansion rather than a
# process: a list is newline-wrapped, so a glob can ask whether a name is in
# it and a prefix strip can pull one value out.
NL='
'

# --- locating things -------------------------------------------------------

# The .pidly directory, found by walking up from the current directory.
root() {
	d=$PWD
	while [ "$d" != / ]; do
		[ -d "$d/.pidly" ] && { printf '%s\n' "$d/.pidly"; return 0; }
		d=$(dirname "$d")
	done
	die 'no .pidly directory found in this directory or any parent'
}

# The directory of one ticket, by number. One traversal, not a search per
# call: callers needing many lookups should use map() instead.
ticket_dir() {
	_td_r=$1 _td_n=$2
	# head, not -quit: find stops anyway when the pipe closes, and -quit is
	# not POSIX. Nothing here needs an option BSD find might not have.
	_td_p=$(find "$_td_r" -type d -name "$_td_n" -print | head -n 1)
	[ -n "$_td_p" ] || die "no ticket $_td_n"
	printf '%s\n' "$_td_p"
}

# Is a ticket closed, or held inside something closed? True when there is a
# c/ between it and the tracker root.
#
# Matched on the path relative to .pidly. An absolute path carries the
# checkout with it, and a checkout that lives under a directory named c —
# ~/c/pidly — would otherwise make every ticket in it look finished: claim
# would see nothing blocked and list would offer everything as ready, both
# wrong in the direction that loses work.
in_closed() {
	case ${2#"$1"/} in c/*|*/c/*) return 0 ;; *) return 1 ;; esac
}

# Every ticket as "number path", one line each, from a single traversal.
#
# The basename is awk's, not find's: -printf is a GNU extension, and BSD find
# — which is what macOS ships — does not have it. That went unnoticed because
# the machine this was written on has bfs as its find, which implements the
# GNU options. Every caller already pipes this into awk, so the split costs
# nothing. -mindepth stays: BSD has it too.
map() {
	find "$1" -mindepth 1 -type d '!' -name c '!' -name '.*' -print |
		awk -F/ '{ print $NF" "$0 }'
}

# --- identity and liveness -------------------------------------------------
#
# A pid means nothing on its own. It is meaningful only relative to a specific
# process table, and only until it is recycled. So a claim records both:
#
#   <pid>.<starttime>@<runtime>
#
# <starttime> distinguishes a recycled pid from the original: a new process
# reusing the number has a different start time. <runtime> identifies the
# process table — boot id, uid, and pid namespace where readable. Together
# they are a unique, checkable process identity the kernel maintains for free.
#
# This is why a plain unique id would not be an improvement. Uniqueness is the
# easy half; the hard half is liveness, and only the OS keeps a registry of
# live processes. A UUID has no registry behind it, so it would identify an
# agent without ever telling you whether that agent still exists.
#
# Agents with no reachable process table — anything in the cloud — cannot use
# any of this, and carry a lease instead.

runtime() {
	_rt_boot=""
	[ -r /proc/sys/kernel/random/boot_id ] &&
		read -r _rt_boot < /proc/sys/kernel/random/boot_id 2>/dev/null || true
	if [ -n "$_rt_boot" ]; then
		_rt_boot=${_rt_boot%%-*}
	else
		# No boot id: fall back to a per-checkout random string. Weaker,
		# because a checkout survives reboots and pids do not.
		_rt_boot=$(checkout_id "$1")
	fi
	_rt_ns=$(readlink /proc/self/ns/pid 2>/dev/null || true)
	case $_rt_ns in
	*"["*) _rt_ns=${_rt_ns#*[}; _rt_ns=".n${_rt_ns%]}" ;;
	*)     _rt_ns="" ;;
	esac
	printf '%s.u%s%s\n' "$_rt_boot" "$(id -u)" "$_rt_ns"
}

checkout_id() {
	_ci_f="$1/.id"
	if [ ! -f "$_ci_f" ]; then
		( umask 077
		  if [ -r /dev/urandom ]; then
			LC_ALL=C tr -dc 'a-z0-9' < /dev/urandom 2>/dev/null |
				dd bs=1 count=12 2>/dev/null > "$_ci_f"
		  else
			printf '%s%s' "$$" "$(date +%s)" > "$_ci_f"
		  fi
		  printf '\n' >> "$_ci_f" )
	fi
	read -r _ci_cid < "$_ci_f"
	printf '%s\n' "$_ci_cid"
}

starttime() { awk '{print $22}' "/proc/$1/stat" 2>/dev/null || true; }

# Is this process identity still running? Only called when the recorded
# runtime matches ours — same boot, same namespace, same uid — so our own
# processes are always visible and absence really does mean gone.
holder_alive() {
	case $1 in
	*.*) _ha_pid=${1%%.*}; _ha_start=${1#*.} ;;
	*)   _ha_pid=$1;       _ha_start="" ;;
	esac
	if [ -d /proc ]; then
		[ -r "/proc/$_ha_pid/stat" ] || return 1
		[ -z "$_ha_start" ] && return 0
		[ "$(starttime "$_ha_pid")" = "$_ha_start" ]
	else
		kill -0 "$_ha_pid" 2>/dev/null
	fi
}

# Who is claiming. An agent with a real process is identified by it; one
# without — a cloud agent, a CI job — names itself in PIDLY_AGENT and must
# carry a lease, because nothing else can establish that it is alive.
holder() {
	if [ -n "${PIDLY_AGENT+set}" ]; then
		# Set but empty is a variable that did not exist, not a caller
		# asking for pid identity — that caller does not set it at all.
		# Silently falling through recorded a local pid for an agent whose
		# process nobody here can check, and said nothing.
		[ -n "$PIDLY_AGENT" ] ||
			die 'PIDLY_AGENT is set but empty: unset it to claim as this process, or give it a name'
		case $PIDLY_AGENT in
		*@*|*" "*) die 'PIDLY_AGENT may not contain @ or spaces' ;;
		esac
		printf '%s@-\n' "$PIDLY_AGENT"
		return 0
	fi
	# CLAUDE_PID is the long-lived Claude Code process. $PPID usually
	# resolves to the same thing, but only because a tool call's shell is
	# a direct child of it — wrap the call and that stops being true.
	_ho_p=${PIDLY_PID:-${CLAUDE_PID:-$PPID}}
	kill -0 "$_ho_p" 2>/dev/null || die "PIDLY_PID=$_ho_p is not a running process"
	_ho_s=$(starttime "$_ho_p")
	if [ -n "$_ho_s" ]; then
		printf '%s.%s@%s\n' "$_ho_p" "$_ho_s" "$(runtime "$1")"
	else
		printf '%s@%s\n' "$_ho_p" "$(runtime "$1")"
	fi
}

# --- leases ----------------------------------------------------------------
#
# A lease is the only liveness signal available to an agent whose process
# table nobody else can reach. It is a promise with an end, not a heartbeat:
# no refresh traffic, and a claim whose holder dies frees itself on expiry.

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

iso_at() {
	date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null ||
	date -u -r "$1"  +%Y-%m-%dT%H:%M:%SZ 2>/dev/null ||
	die 'cannot compute a lease expiry: no usable date(1)'
}

# 90s / 30m / 2h / 3d, or bare seconds, as a number of seconds. Returns 1
# rather than dying: callers know what the value was for and say so.
duration_seconds() {
	case $1 in
	*s) _du_n=${1%s}; _du_m=1 ;;
	*m) _du_n=${1%m}; _du_m=60 ;;
	*h) _du_n=${1%h}; _du_m=3600 ;;
	*d) _du_n=${1%d}; _du_m=86400 ;;
	*)  _du_n=$1;     _du_m=1 ;;
	esac
	case $_du_n in
	''|*[!0-9]*) return 1 ;;
	esac
	printf '%s\n' "$((_du_n * _du_m))"
}

lease_expiry() {
	_le_s=$(duration_seconds "$1") ||
		die "PIDLY_LEASE=$1 is not a duration (e.g. 90s, 30m, 2h)"
	iso_at "$(( $(date -u +%s) + _le_s ))"
}

# Is $1 strictly before $2? Both ISO-8601 UTC, where lexical order is
# chronological order, so this is a string comparison and needs no date
# arithmetic — which is the half of date(1) that is not portable.
before() {
	[ -n "$1" ] && [ -n "$2" ] || return 1
	[ "$1" = "$2" ] && return 1
	[ "$(printf '%s\n%s\n' "$1" "$2" | sort | head -1)" = "$1" ]
}

# Timestamps are ISO-8601 UTC, so lexical order is chronological order.
expired() {
	[ -n "$1" ] || return 1
	[ "$(printf '%s\n%s\n' "$1" "$(now_iso)" | sort | head -1)" = "$1" ]
}

# Split a claim value; sets _c_holder, _c_runtime, _c_expiry.
parse_claim() {
	case $1 in
	*" "*) _c_who=${1% *}; _c_expiry=${1##* } ;;
	*)     _c_who=$1;      _c_expiry="" ;;
	esac
	_c_runtime=${_c_who##*@}
	_c_holder=${_c_who%@*}
}

# One of: free, expired, live, dead, unverifiable.
claim_state() {
	[ -n "$2" ] || { echo free; return 0; }
	parse_claim "$2"
	if expired "$_c_expiry"; then echo expired; return 0; fi
	if [ "$_c_runtime" = "$(runtime "$1")" ]; then
		if holder_alive "$_c_holder"; then echo live; else echo dead; fi
	else
		echo unverifiable
	fi
}

# --- the lock --------------------------------------------------------------
#
# Rewriting a line in info is read-modify-write, so two agents can both see a
# free ticket and both write their pid, with the loser never finding out.
# mkdir is the atomic primitive that prevents it: it fails if the directory
# exists. The lock holds a pid so a crashed holder can be detected and broken
# rather than wedging the ticket forever.

# lock <dir> [seconds]
#
# Without a budget this returns as soon as the lock is held by someone else.
# That is right for claiming — there is other work to pick up — and wrong for
# anything the caller cannot simply skip, like allocating a number, so those
# pass a budget and wait.
lock() {
	_lk_d=$1 _lk_t="$_lk_d/.lock.$$" _lk_n=0
	_lk_budget=${2:-0} _lk_waited=0

	# Write the pid FIRST, into a private file nobody else looks at, then
	# publish it with link(2). A hard link either appears whole or not at
	# all, so the moment .lock exists it already names its owner: there is
	# no instant where the lock is visible but anonymous. link() is also
	# the primitive that stays atomic over NFS, where O_EXCL historically
	# is not.
	printf '%s\n' "$$" > "$_lk_t" || return 1

	while [ "$_lk_n" -lt 100 ]; do
		_lk_n=$((_lk_n+1))
		if ln "$_lk_t" "$_lk_d/.lock" 2>/dev/null; then
			rm -f "$_lk_t"
			return 0
		fi
		_lk_owner=""
		[ -r "$_lk_d/.lock" ] && read -r _lk_owner < "$_lk_d/.lock" 2>/dev/null || true
		if [ -z "$_lk_owner" ]; then
			# Should be unreachable now that publishing is atomic. Kept
			# because the cost of being wrong is two writers: an empty
			# lock is treated as in-flight, never as abandoned.
			continue
		fi
		if kill -0 "$_lk_owner" 2>/dev/null; then
			# A live holder. Wait if we were given a budget: the
			# lock is held for a few syscalls, so a short sleep
			# almost always clears it.
			if [ "$_lk_waited" -lt "$_lk_budget" ]; then
				sleep 0.05 2>/dev/null || sleep 1
				_lk_waited=$((_lk_waited + 1))
				_lk_n=0
				continue
			fi
			rm -f "$_lk_t"
			return 1
		fi
		rm -f "$_lk_d/.lock"                           # a dead one: break it
	done
	rm -f "$_lk_t"
	return 1
}

unlock() { rm -f "$1/.lock"; }

# Replace one line of a file, via a temp file and a rename. Callers hold the
# lock; the rename keeps a crash mid-write from leaving a truncated info.
set_line() {
	_sl_f=$1 _sl_n=$2 _sl_v=$3 _sl_t="$1.$$"
	awk -v n="$_sl_n" -v v="$_sl_v" 'NR==n{print v; next}{print}' "$_sl_f" > "$_sl_t"
	mv "$_sl_t" "$_sl_f"
}

# Fields are lines 4 up to the first blank line, or the end of the file.
# The body is everything after that blank line. Nothing records where either
# begins: the body ends at EOF, and the field boundary sits ahead of the body
# so body content can never reach it.

get_field() {
	awk -v k="$2" '
		NR <= 3 { next }
		$0 == "" { exit }
		index($0, k ":") == 1 { sub("^" k ": *", ""); print; exit }
	' "$1"
}

# Replace a field if present, otherwise append it to the field block. An
# empty value writes a bare key — "handoff:", not "handoff: " — so a cleared
# field is byte-identical to one new has never filled in.
# Callers hold the lock.
set_field() {
	_sf_f=$1 _sf_k=$2 _sf_v=$3 _sf_t="$1.$$"
	awk -v k="$_sf_k" -v v="$_sf_v" '
		function slot() { return v == "" ? k ":" : k ": " v }
		NR <= 3 { print; next }
		!past && $0 == "" {
			if (!hit) print slot()
			past = 1; print; next
		}
		!past && index($0, k ":") == 1 { print slot(); hit = 1; next }
		{ print }
		END { if (!past && !hit) print slot() }
	' "$_sf_f" > "$_sf_t"
	mv "$_sf_t" "$_sf_f"
}

get_body() { awk 'b { print } !b && $0 == "" { b = 1 }' "$1"; }

# Everything wrong with one info file as a file: the three structural lines,
# the field block, and required fields. One finding per line, each prefixed
# with a label — the ticket number for check, the ticket being saved for
# edit. Both ask the same question, so it is written once.
#
# Nothing here looks outside the file. Dependencies, the registry and cycles
# are facts about the tracker, and check owns those.
info_faults() {
	_if_r=$1 _if_f=$2 _if_n=$3
	fields_load "$_if_r"

	# The header in one pass, in this shell: the three structural lines and
	# the field block, which ends at the first blank line. No process at
	# all — this was a sed per structural line, an awk for the block, and a
	# get_field awk per value it wanted back.
	_if_l1="" _if_l2="" _if_l3="" _if_seen=$NL
	{
		IFS= read -r _if_l1 || true
		IFS= read -r _if_l2 || true
		IFS= read -r _if_l3 || true
		while IFS= read -r _if_line; do
			[ -n "$_if_line" ] || break
			case $_if_line in
			*:*) _if_k=${_if_line%%:*} ;;
			*)   printf "%s: '%s' is not a field\n" "$_if_n" "$_if_line"
			     continue ;;
			esac
			case $_FL_DECL in
			*"$NL$_if_k$NL"*) ;;
			*) printf "%s: field '%s' is not in the schema\n" \
				"$_if_n" "$_if_k"
			   continue ;;
			esac
			_if_v=${_if_line#*:}; _if_v=${_if_v# }
			_if_seen="$_if_seen$_if_k=$_if_v$NL"
		done
	} < "$_if_f"

	# The format's own lines, checked the way the project's fields are: by
	# a declared pattern. They were three greps written by hand, each
	# weaker than what any project could ask for — claim: accepted anything
	# after the colon, so a claim nothing could parse was a valid ticket.
	while IFS='	' read -r _if_ln _if_k _if_req _if_pat _if_note; do
		[ -n "$_if_k" ] || continue
		case $_if_ln in
		1) _if_l=$_if_l1 ;;
		2) _if_l=$_if_l2 ;;
		3) _if_l=$_if_l3 ;;
		*) _if_l=$(sed -n "${_if_ln}p" "$_if_f") ;;
		esac
		case $_if_l in
		"$_if_k:"*) ;;
		*) printf '%s: line %s is not %s:\n' "$_if_n" "$_if_ln" "$_if_k"
		   continue ;;
		esac
		# claim: is written without a space after the colon and the
		# others with one, so one optional space comes off either.
		_if_v=${_if_l#"$_if_k":}
		_if_v=${_if_v# }
		if [ -z "$_if_v" ]; then
			[ "$_if_req" = yes ] &&
				printf "%s: %s is empty\n" "$_if_n" "$_if_k"
			continue
		fi
		[ "$_if_pat" != - ] || continue
		_if_st=0
		value_matches "$_if_pat" "$_if_v" || _if_st=$?
		[ "$_if_st" -eq 1 ] &&
			printf "%s: %s is '%s', which is not %s\n" \
				"$_if_n" "$_if_k" "$_if_v" "$_if_note"
	done <<POSITIONAL
$_FL_POS
POSITIONAL

	# Each value against its field's pattern. An empty value is not matched
	# — absence is required:'s question, not match:'s — and a pattern grep
	# cannot compile is a fault in the schema, reported once by
	# schema_faults rather than against every ticket.
	while IFS= read -r _if_entry; do
		[ -n "$_if_entry" ] || continue
		_if_k=${_if_entry%%=*}
		_if_v=${_if_entry#*=}
		[ -n "$_if_v" ] || continue
		field_pattern "$_if_k"; _if_p=$_FP
		[ -n "$_if_p" ] || continue
		_if_st=0
		value_matches "$_if_p" "$_if_v" || _if_st=$?
		if [ "$_if_st" -eq 1 ]; then
			match_complaint "$_if_k" "$_if_p"
			printf "%s: %s is '%s', which %s\n" \
				"$_if_n" "$_if_k" "$_if_v" "$_MC"
		fi
	done <<SEEN
$_if_seen
SEEN

	# created and updated carry patterns of their own, so the pass above
	# has already judged their shape. What is left is the one thing a
	# pattern cannot say: that they agree with each other.
	_if_c=""; _if_u=""
	case $_if_seen in
	*"${NL}created="*) _if_c=${_if_seen#*"${NL}created="}; _if_c=${_if_c%%"$NL"*} ;;
	esac
	case $_if_seen in
	*"${NL}updated="*) _if_u=${_if_seen#*"${NL}updated="}; _if_u=${_if_u%%"$NL"*} ;;
	esac
	before "$_if_u" "$_if_c" &&
		printf '%s: updated is before created\n' "$_if_n"

	# Required means a value. A stubbed key satisfies nothing: an empty
	# field and an absent one read the same to get_field and to awk, so a
	# schema that only demands the line demands nothing a reader can use.
	while IFS= read -r _if_req; do
		[ -n "$_if_req" ] || continue
		case $_if_seen in
		*"$NL$_if_req=$NL"*)
			printf "%s: required field '%s' is empty\n" "$_if_n" "$_if_req" ;;
		*"$NL$_if_req="*) ;;
		*)  printf "%s: required field '%s' is missing\n" "$_if_n" "$_if_req" ;;
		esac
	done <<REQUIRED
$_FL_REQ
REQUIRED
}

# Replace the body — everything after the blank line that ends the fields —
# with the text in $2, or drop it entirely if that is empty. The header and
# the field block are copied through untouched. Callers hold the lock.
set_body() {
	_sb_f=$1 _sb_v=$2 _sb_t="$1.$$"
	awk 'NR>3 && $0 == "" { exit } { print }' "$_sb_f" > "$_sb_t"
	[ -n "$_sb_v" ] && printf '\n%s\n' "$_sb_v" >> "$_sb_t"
	mv "$_sb_t" "$_sb_f"
}

# Add to the body, leaving what is there. This is the operation the format is
# built around — nothing records where a body ends, so appending is appending
# — and it is a blank line and a cat even when done by hand. Callers hold the
# lock.
append_body() {
	_ab_f=$1 _ab_v=$2
	[ -n "$_ab_v" ] || return 0
	printf '\n%s\n' "$_ab_v" >> "$_ab_f"
}

# --- claim / release -------------------------------------------------------

cmd_claim() {
	[ $# -eq 1 ] || die 'usage: pidly claim <number>'
	_r=$(root); _d=$(ticket_dir "$_r" "$1")

	# An agent with no reachable process table has no other liveness
	# signal, so a lease is not optional for it.
	if [ -n "${PIDLY_AGENT:-}" ] && [ -z "${PIDLY_LEASE:-}" ]; then
		die 'PIDLY_AGENT requires PIDLY_LEASE: nothing else can show it is alive'
	fi

	# needs blocks starting, so refuse before taking the lock: a blocked
	# ticket is not claimable regardless of who else is asking.
	_needs=$(sed -n '2s/^needs: *//p' "$_d/info")
	if [ -n "$_needs" ]; then
		_open=""
		_m=$(map "$_r")
		for _dep in $_needs; do
			_dp=$(printf '%s\n' "$_m" | awk -v n="$_dep" '$1==n{print $2; exit}')
			[ -n "$_dp" ] || die "$1 needs $_dep, which does not exist"
			in_closed "$_r" "$_dp" || _open="$_open $_dep"
		done
		[ -z "$_open" ] || die "$1 is blocked by open tickets:$_open"
	fi

	lock "$_d" || die "$1 is being modified by another process"
	_held=$(sed -n '1s/^claim://p' "$_d/info")
	_state=$(claim_state "$_r" "$_held")
	case $_state in
	free|expired) ;;
	live)         unlock "$_d"; die "$1 is held by $_held, which is running" ;;
	dead)         unlock "$_d"
	              die "$1 is held by $_held, which is gone — 'pidly reap' clears it" ;;
	unverifiable) unlock "$_d"
	              die "$1 is held by $_held, which this machine cannot check" ;;
	esac

	_who=$(holder "$_r")
	if [ -n "${PIDLY_LEASE:-}" ]; then
		_who="$_who $(lease_expiry "$PIDLY_LEASE")"
	fi
	set_line "$_d/info" 1 "claim:$_who"
	mark_updated "$_d/info"
	unlock "$_d"
	if [ "$_state" = expired ]; then
		printf '%s claimed by %s (previous lease had expired)\n' "$1" "$_who"
	else
		printf '%s claimed by %s\n' "$1" "$_who"
	fi

	# The point of a handoff is that the next agent sees it without having
	# to know it is there.
	_hand=$(get_field "$_d/info" handoff)
	[ -n "$_hand" ] && printf 'handoff: %s\n' "$_hand"
	# Deferred is an opinion about the work, not a fact about the tracker,
	# so it does not refuse the claim the way a blocker does. It says so
	# and lets whoever asked decide whether the trigger has fired.
	_defer=$(get_field "$_d/info" defer)
	[ -n "$_defer" ] && printf 'deferred until: %s\n' "$_defer"
	return 0
}

cmd_release() {
	_note=""
	while [ $# -gt 0 ]; do
		case $1 in
		-m) [ $# -ge 2 ] || die 'usage: pidly release [-m note] <number>'
		    _note=$2; shift 2 ;;
		-*) die "unknown option $1" ;;
		*)  break ;;
		esac
	done
	[ $# -eq 1 ] || die 'usage: pidly release [-m note] <number>'
	case $_note in
	*"
"*) die 'a handoff note must be one line; put anything longer in the body' ;;
	esac
	_r=$(root); _d=$(ticket_dir "$_r" "$1")

	lock "$_d" || die "$1 is being modified by another process"
	_held=$(sed -n '1s/^claim://p' "$_d/info")
	[ -n "$_held" ] || { unlock "$_d"; die "$1 is not claimed"; }

	# You may only release what you hold. Anything else — including a claim
	# left behind by a dead local agent — is reap's job, which keeps
	# clearing someone else's claim behind an explicit command.
	parse_claim "$_held"
	_mine=$(holder "$_r")
	if [ "$_c_who" != "$_mine" ]; then
		unlock "$_d"
		case $(claim_state "$_r" "$_held") in
		dead) die "$1 is held by $_c_who, which is gone — 'pidly reap' clears it" ;;
		unverifiable)
		      die "$1 is held by $_c_who, which this machine cannot check" ;;
		*)    die "$1 is held by $_c_who, not by you" ;;
		esac
	fi
	set_line "$_d/info" 1 'claim:'
	[ -n "$_note" ] && set_field "$_d/info" handoff "$_note"
	mark_updated "$_d/info"
	unlock "$_d"
	printf '%s released\n' "$1"
	return 0
}

cmd_status() {
	[ $# -eq 1 ] || die 'usage: pidly status <number>'
	_r=$(root); _d=$(ticket_dir "$_r" "$1")
	_held=$(sed -n '1s/^claim://p' "$_d/info")
	_state=$(claim_state "$_r" "$_held")
	if [ "$_state" = free ]; then
		printf '%s\tunclaimed\n' "$1"
	else
		parse_claim "$_held"
		printf '%s\t%s\tholder %s' "$1" "$_state" "$_c_holder"
		[ -n "$_c_expiry" ] && printf '\tlease until %s' "$_c_expiry"
		printf '\n'
	fi
	_hand=$(get_field "$_d/info" handoff)
	[ -n "$_hand" ] && printf 'handoff: %s\n' "$_hand"
	return 0
}

# --- reap ------------------------------------------------------------------
#
# Clearing someone else's claim is the one destructive thing in the tracker,
# so it is a command of its own rather than something check or claim does on
# the way past. What it will clear is exactly the dead state: our runtime, so
# the process table is one we can read, and the process demonstrably absent.
#
# Not live, obviously. Not unverifiable — another machine's pid says nothing
# here, and treating silence as death is how two agents end up on one ticket.
# Not expired either: a lapsed lease is already takeable, so claim handles it
# and reap has nothing to add.
#
# Locks are not its business. A lock names a local pid and lock() breaks a
# dead one on the next attempt, so a stale lock heals itself.

# Clear one dead claim. Prints what it cleared; returns 1, silently, if the
# claim is anything else. Callers decide whether that is worth saying.
reap_one() {
	_rp_r=$1 _rp_d=$2 _rp_n=$3
	lock "$_rp_d" 100 || die "$_rp_n is being modified by another process"
	# Re-read under the lock. Between the scan and here the holder may have
	# released it, or a new agent may have taken it — and that one is alive.
	_rp_h=$(sed -n '1s/^claim://p' "$_rp_d/info")
	if [ "$(claim_state "$_rp_r" "$_rp_h")" != dead ]; then
		unlock "$_rp_d"
		return 1
	fi
	set_line "$_rp_d/info" 1 'claim:'
	mark_updated "$_rp_d/info"
	unlock "$_rp_d"
	parse_claim "$_rp_h"
	printf '%s: cleared the claim by %s, which is gone\n' "$_rp_n" "$_c_holder"
	return 0
}

cmd_reap() {
	[ $# -le 1 ] || die 'usage: pidly reap [number]'
	_r=$(root)

	# Named ticket: say why nothing happened, since the caller asked about
	# this one and a silent success would read as "cleared".
	if [ $# -eq 1 ]; then
		_d=$(ticket_dir "$_r" "$1")
		_held=$(sed -n '1s/^claim://p' "$_d/info")
		parse_claim "$_held"
		case $(claim_state "$_r" "$_held") in
		dead) reap_one "$_r" "$_d" "$1" ||
			printf '%s: the claim was gone before it could be cleared\n' "$1" ;;
		free) die "$1 is not claimed" ;;
		live) die "$1 is held by $_c_holder, which is running" ;;
		expired)
		      die "$1 has an expired lease, which is already takeable — claim it" ;;
		unverifiable)
		      die "$1 is held by $_c_holder, which this machine cannot check — a claim you cannot verify is not a dead one" ;;
		esac
		return 0
	fi

	# A sweep. Closed tickets included: a dead claim left on finished work
	# is still something check reports, so reap has to be able to clear it.
	_rc="${TMPDIR:-/tmp}/pidly.reap.$$"
	: > "$_rc"
	map "$_r" | while read -r _num _path; do
		[ -n "$_num" ] || continue
		case $_num in *[!0-9]*) continue ;; esac
		[ -f "$_path/info" ] || continue
		[ "$(claim_state "$_r" "$(sed -n '1s/^claim://p' "$_path/info")")" = dead ] ||
			continue
		reap_one "$_r" "$_path" "$_num" >> "$_rc" || true
	done
	if [ -s "$_rc" ]; then
		cat "$_rc"
		printf '%s claim(s) cleared\n' "$(wc -l < "$_rc" | tr -d ' ')"
	else
		printf 'nothing to reap\n'
	fi
	rm -f "$_rc"
	return 0
}

# --- edit ------------------------------------------------------------------
#
# The body is the part of a ticket nothing can derive: it is what the work
# was, and after 19 it is where results land too. Editing it by hand is an
# editor, or a cat >> — this command is that plus two things a hand-edit does
# not get: the lock, so an edit and a claim landing together cannot lose each
# other, and a structural read of the file before it replaces the original.
#
# It is not a correctness requirement. It was one while desc: recorded where
# the body ended, because a hand-edit could leave that line lying; 20 removed
# the derived data, and with it the only thing edit had to keep honest.

cmd_edit() {
	_mode=editor
	while [ $# -gt 0 ]; do
		case $1 in
		-a|--append) _mode=append; shift ;;
		-b|--body)   _mode=body; shift ;;
		-*) die "unknown option $1" ;;
		*)  break ;;
		esac
	done
	[ $# -eq 1 ] || die 'usage: pidly edit [-a|-b] <number>'
	_r=$(root); _d=$(ticket_dir "$_r" "$1"); _f="$_d/info"

	if [ "$_mode" = editor ]; then
		# vi with nothing to talk to is a way to hang a script, and an
		# agent that wanted an editor did not want one.
		[ -t 0 ] || [ -n "${VISUAL:-}${EDITOR:-}" ] ||
			die 'no terminal and no $EDITOR: use -b or -a to edit from stdin'
		edit_in_editor "$_r" "$_d" "$1"
		return 0
	fi

	# Reading stdin whole, rather than streaming it into the file, keeps the
	# window in which info is half-written down to the mv. A body is prose.
	_text=$(cat)
	lock "$_d" 100 || die "$1 is being modified by another process"
	if [ "$_mode" = append ]; then
		append_body "$_f" "$_text"
	else
		set_body "$_f" "$_text"
	fi
	mark_updated "$_f"
	unlock "$_d"
	printf '%s updated\n' "$1"
	return 0
}

edit_in_editor() {
	_ee_r=$1 _ee_d=$2 _ee_n=$3 _ee_f="$2/info"
	_ee_ed=${VISUAL:-${EDITOR:-vi}}
	_ee_draft="${TMPDIR:-/tmp}/pidly.$_ee_n.$$"
	cat "$_ee_f" > "$_ee_draft"
	_ee_was=$(cksum < "$_ee_f")

	# The editor runs outside the lock. A lock held for the length of a
	# human edit blocks every claim on that ticket for as long as the
	# session lasts, and a session that never ends leaves one behind. The
	# comparison below is what that costs: instead of excluding a writer,
	# we notice one.
	$_ee_ed "$_ee_draft" ||
		{ rm -f "$_ee_draft"; die "$_ee_n was not written: the editor failed"; }

	if [ "$(cksum < "$_ee_draft")" = "$_ee_was" ]; then
		rm -f "$_ee_draft"
		printf '%s unchanged\n' "$_ee_n"
		return 0
	fi

	# A saved file that is no longer a ticket is the one thing an editor
	# makes easy — a deleted header line, a field that lost its colon, a
	# body that lost the blank line in front of it. The draft is kept: it
	# is the user's work, and it is the only copy of it.
	_ee_bad=$(info_faults "$_ee_r" "$_ee_draft" "$_ee_n")
	if [ -n "$_ee_bad" ]; then
		printf '%s\n' "$_ee_bad" >&2
		die "$_ee_n was not written; your edit is in $_ee_draft"
	fi

	lock "$_ee_d" 100 || die "$_ee_n is being modified by another process"
	if [ "$(cksum < "$_ee_f")" != "$_ee_was" ]; then
		unlock "$_ee_d"
		die "$_ee_n changed while the editor was open; your edit is in $_ee_draft"
	fi
	_ee_t="$_ee_f.$$"
	cat "$_ee_draft" > "$_ee_t"
	mv "$_ee_t" "$_ee_f"
	mark_updated "$_ee_f"
	unlock "$_ee_d"
	rm -f "$_ee_draft"
	printf '%s updated\n' "$_ee_n"
	return 0
}

# --- close / reopen --------------------------------------------------------
#
# Both commands are moves and nothing else. Neither writes to an info file,
# because there is no status field to keep in step: state is the path, so
# moving the directory is the whole operation.

# A ticket is closed when it sits in its container's c/ — that is, when its
# immediate parent directory is named c. Not "the path contains /c/": that is
# also true of an open child of a closed parent, which is the broken state
# check reports rather than a ticket to treat as finished.
is_closed() { case $(dirname "$1") in */c) return 0 ;; *) return 1 ;; esac; }

# Numbered directories sitting directly in a ticket — its open children. A
# finished child is in the ticket's c/, so it is not one of these.
open_children() {
	for _oc in "$1"/*/; do
		[ -d "$_oc" ] || continue
		_oc=${_oc%/}; _oc=${_oc##*/}
		case $_oc in ''|*[!0-9]*) continue ;; esac
		printf '%s\n' "$_oc"
	done
}

# --- writing fields --------------------------------------------------------

# The fields a ticket may carry, in the order the schema declares them, minus
# pidly's own stamps: created records one event and updated means "when pidly
# last wrote here", so neither is a value anyone sets.
# The slate: the fields every ticket gets a line for. The project's, and only
# the project's — new writes them, fields backfills them, and check counts the
# tickets missing one.
slate_fields() {
	_st_own=$(format_fields)
	schema_fields "$1" | while read -r _st_f; do
		[ -n "$_st_f" ] || continue
		# Not one of the format's, whatever the schema says. A project
		# that declared title would otherwise have pidly writing a
		# second title: into the field block, under the real one.
		printf '%s\n' "$_st_own" | grep -qx "$_st_f" && continue
		printf '%s\n' "$_st_f"
	done
}

# What set will write: the slate, plus the format's own fields that are
# neither a line of their own nor a stamp pidly maintains. That is defer —
# a field nobody has to declare, because it is list that reads it, and a
# tracker whose schema never heard of it still has a list.
settable_fields() {
	slate_fields "$1"
	format_cached |
		awk -F'\t' '$4 == "-" && $1 != "created" && $1 != "updated" { print $1 }'
}

# Refuse a value the field's pattern rejects. check would report it a moment
# later, and it keeps the two ways of writing a field — new -f and set —
# agreeing about what a value is. An empty value is required:'s business, and
# a pattern grep cannot compile is the schema's; neither is refused here.
require_match() {
	_rm_p=$(schema_match "$1" "$2")
	[ -n "$_rm_p" ] && [ -n "$3" ] || return 0
	_rm_st=0
	value_matches "$_rm_p" "$3" || _rm_st=$?
	[ "$_rm_st" -eq 1 ] && die "$2 must match $_rm_p, and '$3' does not"
	return 0
}

# One field on one ticket. The same write release makes for handoff, under
# the same lock, for any field the schema declares.
cmd_set() {
	[ $# -ge 2 ] && [ $# -le 3 ] || die 'usage: pidly set <number> <field> [value]'
	_sn=$1 _sk=$2 _sv=${3:-}
	case $_sv in
	*"
"*) die 'a field value is one line' ;;
	esac
	_r=$(root)
	settable_fields "$_r" | grep -qx "$_sk" || {
		case $_sk in
		created|updated) die "$_sk is pidly's own stamp, not a field to set" ;;
		*) die "no field '$_sk' in the schema" ;;
		esac
	}
	# Clearing a required field writes exactly the state check reports, and
	# edit already refuses to install a file it would reject. Refusing here
	# keeps the CLI from being the thing that breaks the ticket.
	if [ -z "$_sv" ] && schema_required "$_r" | grep -qx "$_sk"; then
		die "$_sk is required: give it a value, or change its stanza in the schema"
	fi
	require_match "$_r" "$_sk" "$_sv"
	_sd=$(ticket_dir "$_r" "$_sn")
	lock "$_sd" 100 || die "$_sn is being modified by another process"
	set_field "$_sd/info" "$_sk" "$_sv"
	mark_updated "$_sd/info"
	unlock "$_sd"
	if [ -n "$_sv" ]; then printf '%s %s set\n' "$_sn" "$_sk"
	else printf '%s %s cleared\n' "$_sn" "$_sk"; fi
	return 0
}

# Declared fields one ticket has no line for, in schema order, space-separated.
missing_fields() {
	awk -v decl="$2" '
		NR <= 3 { next }
		$0 == "" { exit }
		{ k = substr($0, 1, index($0, ":") - 1); seen[k] = 1 }
		END {
			n = split(decl, d, "\n")
			for (i = 1; i <= n; i++)
				if (d[i] != "" && !(d[i] in seen)) printf "%s ", d[i]
		}' "$1"
}

# The migration: give every ticket a slot for every field the schema declares.
#
# It adds keys and nothing else. It never removes a field the schema has
# dropped — that is data, and a tracker is the last place to delete data on a
# guess — and it never moves a line that is already there, because a ticket
# written by hand may put its fields in any order and nothing may depend on
# where they sit. A missing key lands in schema order relative to the keys
# that are present, which is the most it can do without moving anything.
#
# It does not bump updated. This is pidly writing, but it is not activity on
# the work: a migration that stamped every ticket would flatten list --stale
# to nothing on the day it ran. Same reasoning that keeps close and reopen
# from touching it.
#
# Never part of init. init is what you run after an upgrade, and rewriting
# every ticket in the tracker is not something that should happen because
# someone refreshed the generated files.
cmd_fields() {
	[ $# -eq 0 ] || die 'usage: pidly fields'
	_r=$(root)
	_fdecl=$(slate_fields "$_r")
	[ -n "$_fdecl" ] || { printf 'the schema declares no fields\n'; return 0; }

	_fout="${TMPDIR:-/tmp}/pidly.fields.$$"
	: > "$_fout"
	_fbusy=0
	map "$_r" | sort -k1,1n | while read -r _fn _fp; do
		[ -n "$_fn" ] || continue
		case $_fn in *[!0-9]*) continue ;; esac
		_ff="$_fp/info"
		[ -f "$_ff" ] || continue
		# A file too short to have a field block is broken, and check
		# is where that is reported. A migration is not a repair.
		[ "$(awk 'END { print NR }' "$_ff")" -ge 3 ] || continue
		_fmiss=$(missing_fields "$_ff" "$_fdecl")
		[ -n "$_fmiss" ] || continue
		if ! lock "$_fp" 100; then
			printf '%s\tbusy\n' "$_fn" >> "$_fout"
			continue
		fi
		_ftmp="$_ff.$$"
		awk -v decl="$_fdecl" '
			{ line[NR] = $0 }
			END {
				if (NR < 3) { for (i = 1; i <= NR; i++) print line[i]; exit }
				n = split(decl, d, "\n")
				for (i = 1; i <= n; i++) if (d[i] != "") idx[d[i]] = i
				# The field block: line 4 to the blank line that
				# starts the body, or to the end of the file.
				end = NR + 1
				for (i = 4; i <= NR; i++)
					if (line[i] == "") { end = i; break }
				for (i = 4; i < end; i++) {
					k = substr(line[i], 1, index(line[i], ":") - 1)
					if (k in idx) have[idx[k]] = 1
				}
				for (i = 1; i <= 3; i++) print line[i]
				# A cursor, not a sort: an existing line is printed
				# where it already sits, and a missing key is
				# printed just before the first declared field that
				# comes after it and is present.
				nd = 1
				for (i = 4; i < end; i++) {
					k = substr(line[i], 1, index(line[i], ":") - 1)
					if (k in idx) {
						while (nd < idx[k]) {
							if (!have[nd] && d[nd] != "") print d[nd] ":"
							nd++
						}
						nd = idx[k] + 1
					}
					print line[i]
				}
				while (nd <= n) {
					if (!have[nd] && d[nd] != "") print d[nd] ":"
					nd++
				}
				for (i = end; i <= NR; i++) print line[i]
			}' "$_ff" > "$_ftmp"
		mv "$_ftmp" "$_ff"
		unlock "$_fp"
		printf '%s\t%s\n' "$_fn" "${_fmiss% }" >> "$_fout"
	done

	if [ ! -s "$_fout" ]; then
		rm -f "$_fout"
		printf 'every ticket already has every declared field\n'
		return 0
	fi
	while IFS='	' read -r _fn _fwhat; do
		case $_fwhat in
		busy) printf '%-5s skipped: being modified by another process\n' "$_fn"
		      _fbusy=1 ;;
		*)    printf '%-5s + %s\n' "$_fn" "$_fwhat" ;;
		esac
	done < "$_fout"
	printf '%s ticket(s) changed\n' "$(grep -vc '	busy$' "$_fout" || true)"
	rm -f "$_fout"
	[ "$_fbusy" -eq 0 ]
}

cmd_close() {
	[ $# -eq 1 ] || die 'usage: pidly close <number>'
	_r=$(root); _d=$(ticket_dir "$_r" "$1")
	is_closed "$_d" && die "$1 is already closed"

	# An open child in a finished tree is the one thing the layout rules
	# out, and the parent is the only place that can refuse it.
	_kids=$(open_children "$_d" | tr '\n' ' ')
	[ -z "$_kids" ] || die "$1 has open children: ${_kids%% } — close them first"

	_cdir=$(dirname "$_d")/c
	mkdir -p "$_cdir"
	mv "$_d" "$_cdir/"
	printf '%s closed\n' "$1"
	return 0
}

cmd_reopen() {
	[ $# -eq 1 ] || die 'usage: pidly reopen <number>'
	_r=$(root)
	# Closed, or open inside a closed ancestor: either way there is a c/
	# between the ticket and the surface, and lifting those out is what
	# reopening means. A ticket with none of them is already open.
	in_closed "$_r" "$(ticket_dir "$_r" "$1")" || die "$1 is already open"

	# Outermost first. A closed ancestor holding live work is exactly what
	# the cascade exists to prevent, so each pass re-locates the ticket and
	# lifts the highest closed level out — one mv per level, and the state
	# is consistent between any two of them.
	while :; do
		_d=$(ticket_dir "$_r" "$1")
		in_closed "$_r" "$_d" || break
		_rel=${_d#"$_r"/}
		_head=${_rel%%c/*}
		_seg=${_rel#*c/}; _seg=${_seg%%/*}
		mv "$_r/${_head}c/$_seg" "$_r/$_head$_seg"
		# An emptied c/ is what a person would have been left with too;
		# removing it keeps the tree readable and cannot lose anything,
		# since rmdir refuses a directory that still holds work.
		rmdir "$_r/${_head}c" 2>/dev/null || true
		printf '%s reopened\n' "$_seg"
	done
	return 0
}

# --- agent instructions ----------------------------------------------------
#
# Written into AGENTS.md (or equivalent) between markers, so re-running
# replaces the block instead of appending a second copy, and anything a human
# wrote around it survives.

AGENTS_BEGIN='<!-- pidly:begin -->'
AGENTS_END='<!-- pidly:end -->'

# The reference that ships with a tracker. Larger than the AGENTS.md block
# and smaller than the design document, which stays in the pidly repo and is
# not available to projects that merely use pidly. Everything an agent needs
# in order to act correctly belongs here; everything explaining *why* the
# format is shaped this way belongs in the design document.

guide_text() {
	cat <<'GUIDE'
# .pidly

How this tracker works. Generated by `pidly agents` — edit the tracker, not
this file. Read it when you need a rule you do not already know; the summary
in AGENTS.md covers the common path.

## Shape

A ticket is a **directory**. Its name is its number. `info` inside it is what
is known about it. Nesting a ticket inside another makes it a subtask.

**State is location.** A ticket is open if it sits directly in its container,
closed if it sits in that container's `c/`. Nothing else records state.

```
.pidly/
  schema           the project's fields, one stanza each
  7/
    info           ticket 7, open
    12/
      info         ticket 12, an open subtask of 7
    c/
      13/info      ticket 13, a finished subtask of 7
  c/
    4/info         ticket 4, finished, top level
```

Numbers are unique across the whole tracker and **never reused**. A path is
made of ticket numbers and `c`, so `.pidly/7/12/` is ticket 12 under 7.

## The info file

```
claim:                        1  empty, or who holds it
needs: 3 8                    2  tickets that must close before this starts
title: Short human title      3
created: 2026-09-16T21:43:59Z 4  when the ticket was made
updated: 2026-09-17T08:02:11Z 5  when pidly last wrote to it
effort: M                     6  project fields, declared in .pidly/schema
handoff: where I got to       7  ...as many as the schema declares, or none
                              8  one blank line
The body, from here           9  ...to the end of the file
```

`created` and `updated` are pidly's own fields rather than the project's, so
they are valid whether or not the schema mentions them. Both are ISO-8601
UTC, which sorts lexically. `created` records one event and nothing touches
it again; `updated` records **an event on this ticket** — `claim`, `release`,
`edit`, `set`, `reap`. Each of those is one agent doing one thing to one
ticket, which is what the stamp is asked about.

A write that landed on every ticket at once does not bump it: `pidly fields`
adds a slot to the whole tracker and says nothing about any one piece of
work, and stamping all of them would flatten `list --stale` on the day it
ran. Nor do `close` and `reopen`, which move a directory without opening the
file, and nor can an edit made by hand or with `sed`, which cannot call
anything at all.

So `updated` is not the file's mtime and not a record of every write. It is
*when something last happened to this ticket, as far as pidly saw*. Use
`pidly edit` if you want the stamp to follow your own edit.

Read only as far as you need. The right-hand column is what the file is, and
it keeps working in a checkout where pidly was never installed; the left is
what to type when it was.

| want | command | read |
|---|---|---|
| the whole ticket | `pidly show 7` | `cat info` |
| where ticket 7 is | `pidly show -p 7` | `find .pidly -type d -name 7` |
| can I take this? | — | `sed -n 1,2p info` |
| a listing line | — | `sed -n 3p info` |
| project fields | `pidly show -F 7` | `awk 'NR>3 { if ($0=="") exit; print }' info` |
| one field of one ticket | `pidly show -f effort 7` | `sed -n 's/^effort: //p' info` |
| one field of every ticket | `pidly field effort` | a loop over the above |
| the body | `pidly show -b 7` | `awk 'b { print } !b && $0=="" { b=1 }' info` |

`show -p` is the one every hand idiom above needs first, and it is why the
other rows can be written as a single `sed` against `info` rather than a
`find` each. A resolved path is yours to read; it is not a licence to write
lines that a command owns — see `set` for `title` and `needs`, and
`reparent` for the directory itself.

Nothing records where the body starts or ends. It runs to the end of the
file, and the fields stop at the first blank line — which is ahead of the
body, so nothing you write in a body can be mistaken for the boundary.
Appending to a body needs no bookkeeping.

## The schema

`.pidly/schema` declares the project's fields, one stanza per field,
separated by a blank line, in the order `pidly new` writes them:

```
field: effort
match: S|M|L
note: rough size

field: area
required: yes
match: format|cli|docs
note: which part of the project
```

`field:` opens a stanza. `required: yes` means a ticket is not valid until
the field has a value. `match:` is a POSIX ERE the value is tested against,
**anchored** — pidly asks `^(<pattern>)$`, so `S|M|L` cannot half-match
`M extra`. No `match:` means anything, an empty value is never matched
against one, and `note:` is one line.

Everything after `match: ` is the pattern, so `|`, spaces, brackets and
braces need no escaping. That is the reason this is not a markdown table:
a table separates its cells on `|` and an ERE alternates on `|`.

Read it the way everything here is read:

```sh
awk '$1 == "field:" { print $2 }' .pidly/schema
awk '$1=="field:" { cur=$2 } $1=="required:" && $2=="yes" { print cur }' \
    .pidly/schema
```

Two things the implementation is stuck with, and so are you:

- **Patterns go through `grep -E`, never awk.** mawk has no interval
  expressions — `[0-9]{4}` matches `2026` under `grep -E` and does not under
  mawk, in a literal `/re/` or a dynamic `$0 ~ p` — and gawk differs again.
  A pattern's meaning must not depend on which awk is installed.
- **Keep to POSIX ERE.** `\d`, `\w`, `\s`, `\b` and `(?...)` are PCRE.
  Some greps take them anyway — ugrep does — so a pattern written against
  whatever is installed here can mean something else on the next machine.
  `pidly check` reports them rather than trusting the local tool, along with
  a pattern grep cannot compile and a stanza with no `field:`.

`claim:`, `needs:` and `title:` are lines 1, 2 and 3 of every ticket: they
belong to the format, not to the project, and are not declared here. Neither
are `created:` and `updated:`.

pidly declares those in the same language, compiled into the script:

```
GUIDE
	format_text
	cat <<'GUIDE'
```

That is the whole grammar of a ticket's header, in one place, and `check`
applies it to every ticket. `line:` is what says a field is read by position
rather than by name — the takeable scan reads lines 1 and 2 by number — and
it is the one key your schema may not use. Declaring any of these names in
`.pidly/schema` is a finding too: a project that could redeclare `title`
could say it may be empty, and every listing prints it.

A finding about one of these shows the `note:` rather than the pattern,
because the pattern is not in a file you can open:

```
7: claim is 'garbage', which is not <pid>.<starttime>@<runtime>, alone or
   followed by a lease expiry, or <agent>@- <expiry>
```

## Telling Claude Code about it

```sh
pidly claude      # writes .claude/skills/pidly/SKILL.md, the slash commands
                  # and, if there is none, a settings.json that allows the
                  # read-only commands without a prompt
```

The skill is the **workflow** — claim before starting, release with `-m` when
stopping early, close when done — and it points back at this file for the
rules rather than restating them. The AGENTS.md block is the format; the
skill is the loop. `/pidly-next`, `/pidly-mine` and `/pidly-drop` are the
three things worth one keystroke.

Both are generated, and `pidly check` compares them against what would be
generated now, for the reason every copy here is compared: a copy that drifts
is worse than no copy. There are no hooks: enforcement is the operator's, and
a hook that blocks a tool call is a strong thing to install on someone's
behalf.

Not an MCP server. That is a process, and the premise is that there is
nothing to run — Bash already reaches the CLI.

## Finding work

```sh
pidly list             # ready work: unclaimed and unblocked
pidly list -a          # every open ticket, with its state
pidly list --stale 7d  # open work pidly has not written to in that long
pidly field effort     # one field across every open ticket, - where it is unset
pidly tree             # the hierarchy, closed tickets marked [x]
pidly check            # report anything wrong; changes nothing
```

`field` prints rows rather than a summary, so the spread of one is `pidly
field effort | awk '{print $2}' | sort | uniq -c`, and the tickets missing it
are the `-` rows. It reads the field by name in a single pass over the
tracker: a loop that runs a command per ticket costs 17.4s over 2000 tickets
where this costs 0.44s.

A ticket with a `defer:` is **not ready**: it is open work that nobody should
pick up yet, and the field says what would change that.

```sh
pidly set 34 defer "picking among unblocked tickets needing a sort"
pidly list -a    # 34  deferred  Priority as a header line (until picking ...)
pidly set 34 defer               # the trigger fired: it is ready again
```

`list` leaves it out, `list -a` shows it with its trigger, and `claim` prints
the trigger rather than refusing — a blocker is a fact about the tracker, and
this is an opinion about the work, so the person asking gets to decide. The
trigger lives on the ticket instead of in a design document nobody reads
while choosing what to do next.

`defer` is pidly's field, like `created` and `updated`: it is not declared in
`.pidly/schema`, `new` does not stub it, and `fields` does not add it. Only
`list` and `claim` read it.

`--stale` takes the same durations a lease does — `90s`, `30m`, `2h`, `7d` —
and lists the oldest first. A ticket with no `updated` line is listed too,
with `-` for the date: it cannot be shown to be fresh, and the question is
what has been forgotten.

By hand, or when pidly is not installed:

```sh
find .pidly -type d -name c -prune -o -name info -print
```

`-prune` is what keeps this from walking finished work. A ticket is
**takeable** when line 1 is empty and every number on line 2 resolves to a
directory whose path contains `/c/`.

Resolve those numbers with **one traversal**, not one `find` per dependency:
build a number-to-path map from a single `find .pidly -type d` and answer
every lookup from it. On a 2000-ticket tree the difference is 26.5s against
2.0s.

## Claiming

```sh
PIDLY_PID=$$ pidly claim 7     # $$ is your agent's process, not the CLI's
pidly status 7
pidly release 7
```

Export `PIDLY_PID` once for the life of your agent. A release only succeeds
for the process that made the claim, so claiming and releasing from separate
invocations have to agree on who you are.

A claim records `<pid>.<starttime>@<runtime>`. The start time is what stops a
recycled pid from looking like the original process; the runtime is boot id,
uid and pid namespace, so a pid is only ever checked against the process
table it came from.

If you have no process anyone here can check — a cloud session, a CI job —
claim with a lease and renew by claiming again before it expires:

```sh
PIDLY_AGENT=ci-run-4821 PIDLY_LEASE=2h pidly claim 7
```

`ci-run-4821` is an example, not a variable: pick any name you will
recognise when you read the claim back, and it is recorded verbatim. An
empty `PIDLY_AGENT` is an error rather than a fallback to your pid, because
it almost always means a variable that does not exist.

A claim resolves to one of:

| state | meaning |
|---|---|
| `expired` | the lease ran out; anyone may take it |
| `live` | same runtime, process is there |
| `dead` | same runtime, process positively is not |
| `unverifiable` | another runtime, lease still good |

`pidly list` agrees with all of this as far as it can without asking the
process table: an **expired** lease is offered as ready — it is takeable, and
a listing that hid it was hiding work — and `list -a` says whose lease ran
out. A **dead** claim still reads `claimed` there, because telling a dead pid
from a live one is a process per ticket, and `claim` refuses it anyway until
`reap` clears it. So the two never disagree about what you can take.

Only `free` and `expired` can be claimed. Only `dead` can be cleared:

```sh
pidly reap 7      # clear a dead claim on one ticket, and say why if it will not
pidly reap        # sweep the whole tracker, closed work included
```

**Never treat `unverifiable` as dead** — that puts two agents on one ticket,
and `reap` will not do it for you. It refuses a live claim, an unverifiable
one, and an expired lease, which needs no clearing because it is already
takeable. A stale `.lock` needs no clearing either: it names a local process,
and the next command to want the lock breaks it.

Claiming rewrites line 1, so it is the one operation that is not safe to do
by hand while other agents are running: `pidly claim` serializes it behind a
lock. Everything else here is safe with `find`, `sed` and `mv`.

### Handing off

If you stop before finishing, say where you got to:

```sh
pidly release -m "Parser works; lexer still fails on nested quotes." 7
```

That lands in the `handoff` field, and `pidly claim` prints it to whoever
picks the ticket up next. One line — anything longer belongs in the body. It
is overwritten by the next handoff, not accumulated, so it always describes
the most recent stop.

## Creating

A project with no tracker starts one with `pidly init`, which seeds this
file, `schema` and the ignore rules. Re-running it refreshes the generated
files and leaves `schema` alone.

```sh
pidly new -f effort=M -f area=cli "Do the thing"     # body from stdin
```

`-f` sets a project field. `pidly new` writes a line for **every field the
schema declares**, in declaration order, whether or not it has a value: an
empty slot shows what the project expects without opening the schema, and it
makes two tickets line up when they are diffed. A field marked `required: yes`
must have a value — `new` refuses without one, and `check` reports a ticket
whose required field is empty as well as one where it is missing. Required
means a value, because an empty field and an absent one read the same to
anything that goes looking.

The uniform blocks do **not** make line numbers dependable. Read a field by
name: that is right for a ticket written under any schema, where counting
lines is right only until the table changes, and then silently wrong for
exactly the old tickets worth reading.

The next number is the **highest number anywhere in the tracker plus one**,
counting closed tickets. There is no counter file. Make the directory inside
the parent, or in `.pidly/` for a top-level ticket, and write the three
header lines, and the stamps:

```sh
mkdir .pidly/7/14
now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
printf 'claim:\nneeds:\ntitle: %s\ncreated: %s\nupdated: %s\n\n%s\n' \
  "Do the thing" "$now" "$now" "Why." > .pidly/7/14/info
printf '%s %s\n' "$(head -c8 /dev/urandom | od -An -tx1 | tr -d ' ')" \
  "Do the thing" > .pidly/.n/14
```

Leaving the timestamps out is not an error — `pidly init` fills in missing
ones from git, or the file's mtime outside a repo, the same way it backfills
a missing registry entry.

That last file is the **number registry**. It is what makes two branches
issuing the same number a merge conflict instead of a silent duplicate, so a
ticket created by hand needs one too. `pidly init` backfills any that are
missing, and `pidly new` writes it for you along with the lock that stops two
agents picking the same number.

## Editing

```sh
pidly edit 7                 # $EDITOR on info, read for structure before it lands
pidly edit -b 7 < body.md    # replace the body from stdin
pidly edit -a 7 <<'EOF'      # append to it: findings, results, where you got to
Reviewed the parser: the lexer loses nested quotes at depth 2.
EOF
```

By hand it is your editor, or `cat >> .pidly/7/info` — nothing records where
a body starts or ends, so appending is appending. What the command adds is the
lock, so an edit and a claim landing together cannot lose each other, and a
refusal to install a saved file that is no longer a ticket: a missing header
line, a field without a colon, a body that lost the blank line in front of
it. A rejected edit is kept, and the path is printed.

Fields are lines, so a one-off is `sed`, and the commands that write one for
you are:

```sh
pidly set 7 effort M          # write a field
pidly set 7 effort            # clear it, unless the schema requires a value
pidly release -m "..." 7      # the one that matters: it writes handoff
pidly fields                  # give every ticket a slot for every declared field
```

`fields` is the migration for a stanza added to the schema after tickets
already exist. It **adds keys and nothing else**: it never drops a field the
schema stopped declaring, because that is data; it never moves a line that is
already there, because a ticket written by hand may order its fields however
it likes; and it does not bump `updated`, because a migration is not activity
on the work and stamping every ticket would flatten `list --stale` on the day
it ran. A missing key lands in schema order relative to the keys that are
present. It is never part of `init`.

`check` reports the same drift — `note: 12 ticket(s) have no 'area' line` —
which is what `fields` would add, from the command that changes nothing. It
is a **note**: printed, but it does not fail `check`. A ticket written by
hand is a legal ticket and will not carry every slot, and the format's own
promise is that mkdir and an editor are enough.

## Delegating to a subagent

A subagent usually shares its parent's process — under Claude Code, a Bash
call from a subagent reports the same `CLAUDE_PID` as the lead agent. So a
pid cannot tell them apart: two claims, one pid, both live. **A subagent
claims as an agent, with a lease**, the same way a cloud agent does:

```sh
PIDLY_AGENT=sub-review-parser PIDLY_LEASE=1h pidly claim 19
```

The lead agent creates the ticket and passes the number down, because it
writes the subagent's prompt:

```sh
pidly new -p 7 "Review the parser changes"     # prints 19
# ...then include "your ticket is 19" in the subagent's instructions
```

When the subagent finishes it leaves a handoff and releases; the lead reads
that and decides whether to close. If the subagent dies, the lease expires
and the ticket frees itself.

**Write down what the subagent found before the context is gone.** Its
output is otherwise ephemeral: it lands in the lead agent's context, gets
summarised, and disappears. Findings go in the body of the ticket the
subagent worked on. Appending to a body is just appending.

If the result is a standalone artifact — a review, a benchmark — put it
where artifacts live in the repo and reference the path from the body. It is
usually about the code rather than about the ticket, so it belongs next to
the code, where everyone finds it and where closing the ticket does not
archive it.

Not a ticket of its own. One created and closed in the same breath is a log
entry wearing a ticket costume, and it spends a number that can never be
reused.

**Not every subagent deserves a ticket.** A lookup or a search does not.
Numbers are never reused and tickets are never deleted, so a ticket per
subagent call is permanent noise — and an open child blocks its parent from
closing, so it does active harm. Open one when the work is a unit you would
want to see in the tracker tomorrow.

## Closing and reopening

Closing is a move into the container's `c/`:

```sh
pidly close 12    # or: mkdir -p .pidly/7/c && mv .pidly/7/12 .pidly/7/c/
pidly reopen 12
```

A ticket **cannot close while it has children outside its own `c/`**. That is
what keeps a finished tree from containing live work.

`reopen` moves it back, and **cascades upward**: if a closed ancestor holds
it, that ancestor reopens too, one move per level. If a subtask needs redoing
then its parent is not finished either. Reopening does not cascade downward,
and does not reopen tickets that `needs` it.

Reopen also takes a ticket that is *already open* but sits inside a closed
ancestor — a state a hand-run `mv` can leave behind, and one `check` reports.
The cascade is its repair.

## Rules that will bite you

- **Never delete a ticket.** Numbers are never reused, and deleting one lets
  its number be issued again to something else. Close it instead.
- **`needs` holds numbers, never paths.** A number is permanent; a path
  changes every time a ticket is closed or re-parented.
- **Parents and dependencies are different things.** `needs` blocks starting;
  children block closing. Neither implies the other, and a parent is never an
  implicit dependency of its own children.
- **Leave a handoff when you stop early.** A dropped claim with no note makes
  the next agent reconstruct your progress from the diff.
GUIDE
}

agents_block() {
	cat <<'BLOCK'
<!-- pidly:begin -->
## Issue tracking with pidly

Work lives in `.pidly/` as plain files. **Full rules: `.pidly/README.md`** —
read it before doing anything beyond the commands below.

A ticket is a directory; `info` inside it is what's known about it. The
directory name is its number, which never changes and is never reused.
**State is location**: open tickets sit directly in their container, closed
ones in that container's `c/`. Closing is a move.

```
.pidly/7/info        ticket 7, open
.pidly/7/12/info     ticket 12, an open subtask of 7
.pidly/7/c/13/info   ticket 13, finished
```

`info` is three header lines, then project fields, then the body:

```
claim:                1  empty, or who holds it
needs: 3 8            2  must be closed before this starts
title: Short title    3
effort: M             4  project fields, then a blank line,
                         then the body to the end of the file
```

The project's fields are declared in `.pidly/schema`, one stanza each —
`field:`, and optionally `required:`, `match:` (a POSIX ERE the value must
match) and `note:`. `pidly new` gives a ticket a slot for every one of them.

```sh
# open tickets, never descending into finished work
find .pidly -type d -name c -prune -o -name info -print

# takeable = line 1 empty, and every number on line 2 resolves to a
# directory whose path contains /c/
sed -n 1,2p .pidly/7/info

PIDLY_PID=$$ pidly claim 7    # $$ is your process, not the CLI's
pidly status 7                # who holds it, and if that is checkable
pidly release 7
pidly release -m "Where I got to" 7   # if you stop before finishing

# no local process (cloud, CI)? claim with a lease and renew before it ends
PIDLY_AGENT=ci-run-4821 PIDLY_LEASE=2h pidly claim 7   # a name you pick

# finish: move into the container's c/
pidly close 7                 # by hand: mkdir -p .pidly/c && mv .pidly/7 .pidly/c/
```

Claim before starting; release or close when done. Delegating real work to a
subagent? Open a child ticket and pass it the number — see the reference, and
note a subagent claims with `PIDLY_AGENT`, not a pid.

- **Never delete a ticket** — numbers are never reused. Close it.
- A ticket cannot close while it has children outside its own `c/`.
- A claim you cannot verify is not a dead one. Leave it alone.
<!-- pidly:end -->
BLOCK
}

cmd_agents() {
	_f=""
	case ${1:-} in
	-f) [ $# -eq 2 ] || die 'usage: pidly agents [-f FILE]'; _f=$2 ;;
	'') for _c in AGENTS.md CLAUDE.md GEMINI.md .cursorrules; do
		[ -f "$_c" ] && { _f=$_c; break; }
	    done
	    [ -n "$_f" ] || _f=AGENTS.md ;;
	*)  die 'usage: pidly agents [-f FILE]' ;;
	esac

	_r=$(root)
	guide_text > "$_r/README.md"

	if [ -f "$_f" ] && grep -qF "$AGENTS_BEGIN" "$_f"; then
		_t="$_f.pidly.$$"
		awk -v b="$AGENTS_BEGIN" -v e="$AGENTS_END" -v blk="$(agents_block)" '
			index($0, b) { print blk; skip = 1; next }
			index($0, e) { skip = 0; next }
			!skip        { print }
		' "$_f" > "$_t"
		mv "$_t" "$_f"
		printf 'updated the pidly section in %s, and %s/README.md\n' "$_f" "$_r"
	else
		[ -f "$_f" ] && [ -s "$_f" ] && printf '\n' >> "$_f"
		agents_block >> "$_f"
		printf 'added a pidly section to %s, and wrote %s/README.md\n' "$_f" "$_r"
	fi
}

# --- Claude Code integration -----------------------------------------------
#
# A skill, slash commands and a permissions block. Not an MCP server: that is
# a running process, and the whole premise is that there is nothing to run —
# a checkout where pidly was never installed is still workable with find, sed
# and mv, and Bash already reaches the CLI. What tools would buy is typed
# arguments, structured results and per-command permission gating; ticket 23
# records when that would be worth revisiting.
#
# Generated, like AGENTS.md and the reference, and compared by check for the
# same reason: this is pidly's prose about pidly, and a copy that drifts is
# worse than no copy. What is not generated is enforcement — no hooks. In
# this project enforcement has been the operator's job, and a hook that
# blocks a tool call is a strong thing to install on someone's behalf.

# "path function" per line, relative to .claude. Read by the command that
# writes them and by the check that compares them, so neither can forget one.
claude_files() {
	printf '%s\n' \
		'skills/pidly/SKILL.md claude_skill_text' \
		'commands/pidly-next.md claude_next_text' \
		'commands/pidly-mine.md claude_mine_text' \
		'commands/pidly-drop.md claude_drop_text'
}

claude_skill_text() {
	cat <<'SKILL'
---
name: pidly
description: Use when picking up, working on, or finishing work tracked in .pidly/ — claiming a ticket before starting, handing one back, closing one, or asking what there is to do. Covers the workflow; the format itself is in .pidly/README.md.
---

# pidly

Work lives in `.pidly/` as plain files. This skill is the loop an agent
follows; **the rules of the format are in `.pidly/README.md`**, which is
generated and kept in step by `pidly check`. Read it when you need a rule you
do not already know, rather than guessing from the file layout.

## The loop

```sh
pidly list                    # ready work: unclaimed, unblocked, not deferred
pidly claim 7                 # take it BEFORE you start
# ...do the work...
pidly close 7                 # finished
```

If you stop before finishing, say where you got to. The next agent reads it:

```sh
pidly release -m "Parser works; the lexer still loses nested quotes." 7
```

## Rules that matter more than they look

- **Claim before starting.** A claim is how two agents avoid the same ticket.
  It records your process, so a claim left by an agent that died is
  detectable — `pidly check` reports it and `pidly reap` clears it.
- **Never delete a ticket.** Numbers are never reused, and deleting one lets
  its number be issued again to something else. Close it.
- **A ticket cannot close while it has open children.**
- **A claim you cannot verify is not a dead one.** Leave it alone.
- **Write findings into the ticket body** — `pidly edit -a 7` — before the
  context is gone. Anything else you learned disappears when the session does.

## If you are a subagent

A subagent shares its parent's process, so a pid cannot tell you apart. Claim
as an agent, with a lease, and release when you finish:

```sh
PIDLY_AGENT=sub-review-parser PIDLY_LEASE=1h pidly claim 19
```

## Making a ticket

```sh
pidly new -f effort=M "Short title"   # body on stdin; -p N for a subtask
```

Not for work you are finishing in the same breath — a ticket opened and
closed at once is a log entry wearing a ticket costume, and it spends a
number that can never be reused.

## Without pidly installed

Everything above is files, and `.pidly/README.md` gives the `find`, `sed` and
`mv` equivalent of every command here — for a checkout where the script was
never installed, which the format is built to survive.
SKILL
}

claude_next_text() {
	cat <<'NEXT'
---
description: Show what is ready to start in .pidly, and claim one if asked.
argument-hint: [ticket number to claim]
---

Run `pidly list`. That is ready work: unclaimed, unblocked and not deferred.

If the user named a number, claim it with `pidly claim <n>` and say what the
ticket asks for, reading its body with `pidly edit`-free tools — `cat` the
`info` file or use `pidly tree` for context. Print the handoff if `claim`
shows one; somebody stopped part-way and it says where.

If the user named nothing, show the list and stop. Picking is theirs unless
they say otherwise.

`pidly list -a` is the fuller picture — blocked, claimed and deferred work
with the reason for each — and worth showing if the ready list is empty.
NEXT
}

claude_mine_text() {
	cat <<'MINE'
---
description: Show which .pidly tickets this session is holding.
---

Find the tickets this session has claimed and report them.

```sh
pidly list -a            # the claimed ones are marked
pidly status <n>         # who holds it, and whether that can be verified
```

A claim records the holding process, so a ticket held by this session shows
the same pid `pidly claim` would write here. Report, for each:

- the number and title,
- whether it is still claimed by this session,
- and whether anything has been written to it — `pidly list --stale 1h` shows
  what has been sitting.

If a ticket has been held without progress, say so and offer to release it
with a handoff (`pidly release -m "..." <n>`) rather than leaving a claim
nobody will clear.
MINE
}

claude_drop_text() {
	cat <<'DROP'
---
description: Hand a .pidly ticket back with a note about where you got to.
argument-hint: <ticket number>
---

Release the ticket the user named, with a handoff that says where the work
actually got to:

```sh
pidly release -m "Where I got to, in one line." <n>
```

The note is one line and it is overwritten by the next one, so write the
state of the work rather than a log of the session. Anything longer belongs
in the body: `pidly edit -a <n>`.

Before releasing, put anything worth keeping into the body — findings, what
was tried, what failed. A dropped claim with no note makes the next agent
reconstruct your progress from the diff.

If the work is finished, `pidly close <n>` instead.
DROP
}

# Read-only commands pre-approved; everything that writes still prompts. The
# split is deliberate: list and check cannot lose anything, and claim, close
# and reap can.
claude_settings_text() {
	cat <<'SETTINGS'
{
  "permissions": {
    "allow": [
      "Bash(pidly list:*)",
      "Bash(pidly tree:*)",
      "Bash(pidly status:*)",
      "Bash(pidly check:*)",
      "Bash(pidly field:*)"
    ]
  }
}
SETTINGS
}

cmd_claude() {
	[ $# -eq 0 ] || die 'usage: pidly claude'
	root >/dev/null                        # refuse outside a tracker
	claude_files | while read -r _cl_p _cl_fn; do
		mkdir -p ".claude/$(dirname "$_cl_p")"
		"$_cl_fn" > ".claude/$_cl_p"
		printf 'wrote .claude/%s\n' "$_cl_p"
	done

	# settings.json is the project's, and it is JSON — which this script
	# has no business parsing, for the same reason the schema is not. So:
	# write it when there is none, and otherwise print what to add.
	if [ -f .claude/settings.json ]; then
		printf '\n.claude/settings.json exists and is yours to edit. To stop\n'
		printf 'the prompts on the commands that cannot lose anything, add:\n\n'
		claude_settings_text | sed 's/^/    /'
	else
		claude_settings_text > .claude/settings.json
		printf 'wrote .claude/settings.json, allowing the read-only commands\n'
	fi
}

# --- the number registry ---------------------------------------------------
#
# .pidly/.n/<number> is created when a number is issued and never modified.
# It holds a nonce and the title.
#
# Its job is to make a collision that git would otherwise merge silently into
# one that git refuses. Two branches cannot see each other while they
# allocate, so the lock cannot help: branch A creating .pidly/5 and branch B
# creating .pidly/7/5 merge cleanly and leave two tickets numbered 5. With a
# registry, both write .pidly/.n/5 with different content, and the merge stops
# with an add/add conflict naming the number.
#
# This detects rather than prevents. Only a non-coordinating id — a hash, a
# timestamp — could prevent it, and that costs the readable number the whole
# format is built around. Being told at merge time, before anything is built
# on the bad state, is the trade.
#
# It also means a number is never reissued even if a ticket directory is
# deleted by hand, and gives a dangling `needs: 5` something to say about
# what 5 was.

nonce() {
	if [ -r /dev/urandom ]; then
		LC_ALL=C tr -dc 'a-z0-9' < /dev/urandom 2>/dev/null | dd bs=1 count=8 2>/dev/null
	else
		printf '%s%s' "$$" "$(date +%s)"
	fi
}

registry_dir() { printf '%s/.n\n' "$1"; }

# Record that a number has been issued. Never overwrites: the content is what
# distinguishes two branches that took the same number.
register() {
	_rg_d=$(registry_dir "$1")
	mkdir -p "$_rg_d"
	[ -e "$_rg_d/$2" ] && return 0
	printf '%s %s\n' "$(nonce)" "$3" > "$_rg_d/$2"
}

registry_highest() {
	_rh_d=$(registry_dir "$1")
	[ -d "$_rh_d" ] || { echo 0; return 0; }
	ls "$_rh_d" 2>/dev/null | awk '{ if ($1+0 > m) m = $1+0 } END { print m+0 }'
}

# --- new -------------------------------------------------------------------

# Project fields the schema marks required, one per line. A ticket without a
# value for one is still readable — check reports it — but new refuses to
# make one, so a ticket starts valid rather than starting wrong.
schema_required() { schema_cached "$1" | awk -F'\t' '$2 == "yes" { print $1 }'; }

# The highest number issued: the greater of what the registry records and
# what the tree contains. Both are needed — the registry catches numbers whose
# ticket was deleted, and the tree catches tickets created by hand, which the
# format explicitly allows.
highest() {
	_hi_tree=$(map "$1" | awk '{ if ($1+0 > m) m = $1+0 } END { print m+0 }')
	_hi_reg=$(registry_highest "$1")
	if [ "$_hi_reg" -gt "$_hi_tree" ]; then printf '%s\n' "$_hi_reg"
	else printf '%s\n' "$_hi_tree"; fi
}

# The value a -f gave for one field, or nothing. The pairs are one per line,
# which is why a value may hold spaces but not a newline. A repeated -f reads
# as a correction: the last one wins.
pair_value() {
	printf '%s\n' "$2" | awk -v k="$1" '
		index($0, k "=") == 1 { v = substr($0, length(k) + 2); seen = 1 }
		END { if (seen) print v }'
}

NEW_USAGE='usage: pidly new [-p parent] [-n "3 8"] [-f name=value] <title>'

cmd_new() {
	_parent="" _needs="" _pairs=""
	while [ $# -gt 0 ]; do
		case $1 in
		-p) [ $# -ge 2 ] || die "$NEW_USAGE"
		    _parent=$2; shift 2 ;;
		-n) [ $# -ge 2 ] || die "$NEW_USAGE"
		    _needs=$2; shift 2 ;;
		-f) [ $# -ge 2 ] || die "$NEW_USAGE"
		    case $2 in
		    *"
"*) die 'a field value is one line' ;;
		    esac
		    _pairs="$_pairs$2
"
		    shift 2 ;;
		-*) die "unknown option $1" ;;
		*)  break ;;
		esac
	done
	[ $# -eq 1 ] || die "$NEW_USAGE"
	_title=$1
	case $_title in
	'') die 'a ticket needs a title' ;;
	*"
"*) die 'a title must be one line' ;;
	esac

	_r=$(root)

	if [ -n "$_parent" ]; then
		_pd=$(ticket_dir "$_r" "$_parent")
		# An open child inside a closed parent would put live work in a
		# finished tree, which is the one thing the layout rules out.
		in_closed "$_r" "$_pd" &&
			die "$_parent is closed — reopen it before adding children"
	else
		_pd=$_r
	fi

	for _dep in $_needs; do
		case $_dep in
		''|*[!0-9]*) die "needs takes ticket numbers, not '$_dep'" ;;
		esac
		ticket_dir "$_r" "$_dep" >/dev/null
	done

	# Both loops read from a here-document rather than a pipe: a pipeline's
	# while runs in a subshell, where die would kill the subshell and leave
	# the ticket half-made.
	_decl=$(known_fields "$_r")
	while IFS= read -r _pair; do
		[ -n "$_pair" ] || continue
		case $_pair in
		*=*) _fk=${_pair%%=*} ;;
		*)   die "-f takes name=value, not '$_pair'" ;;
		esac
		# pidly's own stamps. Letting -f write them would put a value in
		# the file that contradicts what the command just did.
		case $_fk in
		'') die '-f needs a field name before the =' ;;
		created|updated) die "$_fk is pidly's own stamp, not a field to set" ;;
		esac
		printf '%s\n' "$_decl" | grep -qx "$_fk" ||
			die "no field '$_fk' in the schema"
		require_match "$_r" "$_fk" "${_pair#*=}"
	done <<PAIRS
$_pairs
PAIRS

	# A required field with no value would make every fresh ticket fail
	# check, which is what makes required mean something: the value has to
	# come from somewhere, and -f is where.
	_missing=""
	while IFS= read -r _req; do
		[ -n "$_req" ] || continue
		[ -n "$(pair_value "$_req" "$_pairs")" ] ||
			_missing="$_missing $_req"
	done <<REQ
$(schema_required "$_r")
REQ
	[ -z "$_missing" ] ||
		die "the schema requires a value for:$_missing — supply it with -f name=value"

	# Scan before locking. A stale answer only costs a few extra mkdir
	# attempts, and it keeps the critical section down to those attempts
	# rather than a full traversal of the tracker.
	_n=$(highest "$_r")

	# mkdir only arbitrates between siblings, so two agents adding children
	# to different parents would otherwise both take the same number. 200
	# attempts at 50ms is ten seconds, far longer than any real contention.
	lock "$_r" 200 || die 'the tracker is busy; try again'
	while :; do
		_n=$((_n + 1))
		mkdir "$_pd/$_n" 2>/dev/null && break
		[ "$_n" -gt 1000000 ] && { unlock "$_r"; die 'cannot allocate a number'; }
	done
	register "$_r" "$_n" "$_title"
	unlock "$_r"

	{
		printf 'claim:\n'
		printf 'needs:%s\n' "${_needs:+ $_needs}"
		printf 'title: %s\n' "$_title"
		_now=$(now_iso)
		printf 'created: %s\n' "$_now"
		printf 'updated: %s\n' "$_now"
		# Every field the schema declares, in the order the table gives
		# them, whether or not it has a value. An empty slot is a prompt
		# — the project's expectations without opening the schema — and it
		# makes two tickets line up when they are diffed. The order lives
		# in the table, so the table is the one place it is decided.
		#
		# It does not make line numbers dependable. Uniform tickets make
		# "the body starts at line 5+N" true today and wrong after the
		# next schema change, for exactly the old tickets worth reading.
		schema_fields "$_r" | while read -r _f; do
			case $_f in ''|created|updated) continue ;; esac
			_fv=$(pair_value "$_f" "$_pairs")
			if [ -n "$_fv" ]; then printf '%s: %s\n' "$_f" "$_fv"
			else printf '%s:\n' "$_f"; fi
		done
		if [ ! -t 0 ]; then
			_body=$(cat)
			[ -n "$_body" ] && printf '\n%s\n' "$_body"
		fi
	} > "$_pd/$_n/info"

	printf '%s\t%s\n' "$_n" "$_pd/$_n/info"
}

# --- init ------------------------------------------------------------------

# The tracker's own ignore rules live inside .pidly, not in the repo root, so
# the tracker is self-contained: copying or deleting the directory does not
# leave stale entries behind in a file it does not own.
ignore_text() {
	cat <<'IGNORE'
# Transient locks, held for the duration of one command. A lock in a commit
# names a process on someone else's machine and can only mislead.
.lock
.lock.*

# Fallback checkout identity, used only where there is no boot id to derive a
# runtime from. It is per-machine by definition.
.id

# .n/ is deliberately NOT ignored. It is the number registry, and it only
# stops two branches issuing the same number if it is committed.
IGNORE
}

# The starting schema. The three header lines are structural and always
# present, so they are documented rather than declared; the table below them
# is the project's own, and starts with just the handoff field.
schema_text() {
	cat <<'SCHEMA'
# The project's fields: one stanza per field, separated by a blank line, in
# the order pidly writes them into a new ticket.
#
#   field:     the name, which is the key on its line in a ticket's info
#   required:  yes means a ticket is not valid until the field has a value
#   match:     a POSIX ERE the value must match, tested anchored as ^(...)$
#   note:      one line, for whoever opens this file
#
# Everything after "match: " is the pattern, so | [ ] { } and spaces need no
# escaping. Keep to POSIX ERE: \d, \w, \s, \b and (?...) are PCRE, and
# pidly reports them rather than trusting whichever grep is installed here.
#
# Lines 1, 2 and 3 of a ticket are claim:, needs: and title:. They are the
# format's, not the project's, and are not declared here. Neither are
# created: and updated:, which are pidly's own stamps.

field: handoff
note: where the last agent got to when they stopped
SCHEMA
}

# When a file first appeared, as ISO-8601 UTC. The commit that added it if
# this is a git checkout, and the file's own mtime if it is not — which is
# only the same thing for a ticket nobody has edited since.
#
# Both are reconstructions of something the format did not record, which is
# why only init does this, only for a ticket with no created line, and never
# for one it is about to write itself.
first_seen() {
	# --follow, because closing is a move: without it the commit that put
	# the ticket in a c/ looks like the commit that created it, and every
	# finished ticket is dated the day it finished.
	_fs_w=$(TZ=UTC0 git log --follow -1 --diff-filter=A --format=%cd \
		--date=format-local:%Y-%m-%dT%H:%M:%SZ -- "$1" 2>/dev/null) || _fs_w=""
	[ -n "$_fs_w" ] ||
		_fs_w=$(TZ=UTC0 date -r "$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null) || _fs_w=""
	printf '%s\n' "$_fs_w"
}

# When a file last changed, as ISO-8601 UTC: the most recent commit touching
# it, or its mtime outside a repo. Used only to backfill updated, and only
# once — after that pidly maintains the field itself.
last_seen() {
	_ls_w=$(TZ=UTC0 git log --follow -1 --format=%cd \
		--date=format-local:%Y-%m-%dT%H:%M:%SZ -- "$1" 2>/dev/null) || _ls_w=""
	[ -n "$_ls_w" ] ||
		_ls_w=$(TZ=UTC0 date -r "$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null) || _ls_w=""
	printf '%s\n' "$_ls_w"
}

# The nearest .pidly at or above a directory, or nothing.
find_root() {
	_fr_d=$1
	while [ "$_fr_d" != / ]; do
		[ -d "$_fr_d/.pidly" ] && { printf '%s\n' "$_fr_d/.pidly"; return 0; }
		_fr_d=$(dirname "$_fr_d")
	done
	return 0
}

cmd_init() {
	[ $# -eq 0 ] || die 'usage: pidly init'
	_ir="$PWD/.pidly"

	if [ -d "$_ir" ]; then
		_fresh=no
	else
		# A tracker inside another tracker would be found by the outer
		# one's traversals, and its numbers would collide.
		_outer=$(find_root "$PWD")
		[ -n "$_outer" ] &&
			die "$_outer already tracks this directory; pidly does not nest"
		mkdir "$_ir" || die "cannot create $_ir"
		_fresh=yes
	fi

	# The schema belongs to the project once it exists. Everything else here
	# is generated, so re-running init is a refresh rather than a reset.
	if [ -f "$(schema_file "$_ir")" ]; then
		_schema=kept
	else
		schema_text > "$(schema_file "$_ir")"
		_schema=written
	fi
	ignore_text > "$_ir/.gitignore"

	# Backfill the registry for a tracker that predates it, or for tickets
	# created by hand. Without an entry a number has no merge guard.
	mkdir -p "$(registry_dir "$_ir")"
	_added=0
	map "$_ir" | while read -r _num _path; do
		[ -e "$(registry_dir "$_ir")/$_num" ] && continue
		register "$_ir" "$_num" "$(sed -n '3s/^title: //p' "$_path/info" 2>/dev/null)"
		printf 'x\n' >> "$_ir/.backfilled.$$"
	done
	[ -f "$_ir/.backfilled.$$" ] &&
		{ _added=$(wc -l < "$_ir/.backfilled.$$"); rm -f "$_ir/.backfilled.$$"; }

	# Date the tickets that predate the timestamps, or that were written by
	# hand. A ticket nothing can date keeps no line at all: a guess that
	# cannot be told apart from a record is worse than the gap it fills.
	_dated=0
	map "$_ir" | while read -r _num _path; do
		# Unreadable is not the same as undated. A file we cannot read is
		# one we must not rewrite, so it is skipped whole.
		[ -r "$_path/info" ] || continue
		_did=no
		_made=$(get_field "$_path/info" created)
		if [ -z "$_made" ]; then
			_made=$(first_seen "$_path/info")
			[ -n "$_made" ] &&
				{ set_field "$_path/info" created "$_made"; _did=yes; }
		fi
		if [ -z "$(get_field "$_path/info" updated)" ]; then
			_when=$(last_seen "$_path/info")
			# A file whose history starts after the ticket does — a
			# move, a rewrite — would otherwise be updated before it
			# was created, which check reads as damage.
			before "$_when" "$_made" && _when=$_made
			[ -n "$_when" ] &&
				{ set_field "$_path/info" updated "$_when"; _did=yes; }
		fi
		# An if, not an && list: this is the last command in the loop
		# body, so its status becomes the loop's, and the loop's becomes
		# init's. A ticket that needed no dating is not a failure.
		if [ "$_did" = yes ]; then printf 'x\n' >> "$_ir/.dated.$$"; fi
	done
	[ -f "$_ir/.dated.$$" ] &&
		{ _dated=$(wc -l < "$_ir/.dated.$$"); rm -f "$_ir/.dated.$$"; }

	if [ "$_fresh" = yes ]; then
		printf 'created %s\n' "$_ir"
	else
		printf 'refreshed %s\n' "$_ir"
	fi
	printf 'schema %s, .gitignore written\n' "$_schema"
	[ "${_added:-0}" -gt 0 ] &&
		printf 'registered %s number(s) that had no entry\n' "$_added"
	[ "${_dated:-0}" -gt 0 ] &&
		printf 'dated %s ticket(s) that had no timestamps\n' "$_dated"
	cmd_agents "$@"
	return 0
}

# --- views -----------------------------------------------------------------

# Field names a ticket may carry: what the schema declares, plus the ones
# pidly writes itself.
#
# created is pidly's rather than the project's. It is a fact about the ticket
# that nothing else in the file records and that no later edit can make
# false, so new writes it whether or not the schema has heard of it — an older
# tracker gets dated tickets without its schema, which the project owns,
# being rewritten underneath it.
known_fields() {
	# Only the format's fields that sit in the block. claim, needs and
	# title are lines of their own, so a second one inside the block is a
	# stray, not a field.
	format_cached | awk -F'\t' '$4 == "-" && $1 != "" { print $1 }'
	schema_fields "$1"
}

# Record that a ticket changed. Called by everything that writes to info,
# and by nothing else: close and reopen move a directory without opening the
# file, and a hand-edit cannot call anything at all. Callers hold the lock.
mark_updated() { set_field "$1" updated "$(now_iso)"; }

# --- the schema ------------------------------------------------------------
#
# The project's fields, one stanza each, in .pidly/schema — the format's own
# key: value lines applied to its own configuration. It was a markdown table
# until a value needed a regex: a table separates cells on | and an ERE
# alternates on |, so the table could not hold the one validator worth having.
# Nothing after "match: " is a delimiter, which is what buys a pattern its |,
# brackets, braces and spaces with no escaping.
#
# No extension, for the reason info has none: an editor that thinks a file is
# markdown will reflow it.
schema_file() { printf '%s/schema\n' "$1"; }

# Stanzas in, "name<TAB>required<TAB>match<TAB>line" out, in declaration
# order. Reads stdin, because the project's schema is a file and the format's
# own declarations are compiled into this script, and they are the same
# language. A pattern holding a tab would break this line, which is what
# schema_faults reports.
parse_stanzas() {
	awk '
		# "-" for an absent column, never an empty one: tab is IFS
		# whitespace, so a shell read collapses two tabs into one and
		# every later column shifts left. Same reason survey() does it.
		function dash(v) { return v == "" ? "-" : v }
		function flush() {
			if (name != "")
				printf "%s\t%s\t%s\t%s\t%s\n",
					name, req, dash(pat), dash(ln), dash(nt)
			name = ""; req = "no"; pat = ""; ln = ""; nt = ""
		}
		{ sub(/^[ \t]+/, "") }
		/^#/ { next }
		# A blank line closes the stanza, so a key that follows one
		# belongs to nothing rather than to whatever came before it.
		# schema_faults reports that stanza; this one just ignores it.
		$0 == "" { flush(); next }
		# line: comes before field:, so it is held until the stanza it
		# opens is flushed.
		$1 == "line:" { pending = $2; next }
		$1 == "field:" { flush(); name = $2; ln = pending; pending = ""; next }
		name == "" { next }
		$1 == "required:" { req = $2; next }
		index($0, "match:") == 1 { pat = substr($0, 7); sub(/^ /, "", pat); next }
		index($0, "note:") == 1 { nt = substr($0, 6); sub(/^ /, "", nt); next }
		END { flush() }
	'
}

schema_table() {
	_sc_f=$(schema_file "$1")
	[ -f "$_sc_f" ] || return 0
	parse_stanzas < "$_sc_f"
}

# The format's own fields, in the language a project declares its own.
#
# Compiled in rather than seeded, because a project that could edit these
# could say a title may be empty, and every listing in the tracker depends on
# it not being. claim, needs and title are lines 1, 2 and 3 by position
# rather than by name — the takeable scan reads them by number — so line:
# says so, and it is the one key the project's schema may not use.
format_text() {
	cat <<'FORMAT'
line: 1
field: claim
match: [0-9]+(\.[0-9]+)?@[0-9a-z]+\.u[0-9]+(\.n[0-9]+)?( [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?|[^ @]+@- [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z
note: <pid>.<starttime>@<runtime>, alone or followed by a lease expiry, or <agent>@- <expiry>

line: 2
field: needs
match: [0-9]+( [0-9]+)*
note: ticket numbers separated by spaces

line: 3
field: title
required: yes
match: .+
note: one line, and never empty

field: defer
note: why this is not work yet, and what would make it work

field: created
match: [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z
note: an ISO-8601 UTC timestamp

field: updated
match: [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z
note: an ISO-8601 UTC timestamp
FORMAT
}

format_cached() {
	if [ -z "${_format_read:-}" ]; then
		_format_tab=$(format_text | parse_stanzas)
		_format_read=yes
	fi
	printf '%s\n' "$_format_tab"
}

# Every name the format claims, positional or not.
format_fields() { format_cached | cut -f1; }

# Every declaration this command will need, flattened into shell variables
# once. Lookups are then parameter expansion: no process, and nothing
# reparsed per ticket.
#
# check calls info_faults for every ticket, and the tables underneath were
# being rebuilt each time — two awks and a subshell per field per ticket. The
# cache existed; the pipelines it ran inside are what defeated it.
#
# The format wins over the project for any name they share, which is the same
# rule field_match applies and the reason a schema cannot weaken title.
fields_load() {
	[ -z "${_fl_done:-}" ] || return 0
	_FL_DECL=$NL _FL_PAT=$NL _FL_NOTE=$NL _FL_REQ=$NL _FL_POS=""
	fields_absorb format <<FORMAT
$(format_cached)
FORMAT
	fields_absorb project <<PROJECT
$(schema_cached "$1")
PROJECT
	_fl_done=yes
}

# One table of stanzas into those variables. Called for the format first, so
# that a name the project also declares is already taken — the same rule
# field_match applies, and the reason a schema cannot weaken title.
fields_absorb() {
	while IFS='	' read -r _fl_k _fl_req _fl_pat _fl_ln _fl_note; do
		[ -n "$_fl_k" ] || continue
		case $_FL_DECL$_FL_POS in
		*"$NL$_fl_k$NL"*|*"	$_fl_k	"*) continue ;;
		esac
		if [ "$_fl_ln" != - ]; then
			# A line of its own, so not a field of the block.
			_FL_POS="$_FL_POS$_fl_ln	$_fl_k	$_fl_req	$_fl_pat	$_fl_note$NL"
			continue
		fi
		_FL_DECL="$_FL_DECL$_fl_k$NL"
		if [ "$_fl_pat" != - ]; then
			_FL_PAT="$_FL_PAT$_fl_k=$_fl_pat$NL"
		fi
		# Only the format's notes reach a finding. Its patterns are
		# compiled into this script, so a reader cannot go and look at
		# one; a project's pattern is in a file the project wrote, and
		# naming it points at the line.
		if [ "$1" = format ] && [ "$_fl_note" != - ]; then
			_FL_NOTE="$_FL_NOTE$_fl_k=$_fl_note$NL"
		fi
		if [ "$_fl_req" = yes ]; then
			_FL_REQ="$_FL_REQ$_fl_k$NL"
		fi
	done
}

# One field's pattern, or its note, from the tables above — into _FP and _FN
# rather than onto stdout, because a command substitution is a fork and this
# is asked once per field per ticket.
field_pattern() {
	_FP=""
	case $_FL_PAT in
	*"$NL$1="*) _FP=${_FL_PAT#*"$NL$1="}; _FP=${_FP%%"$NL"*} ;;
	esac
}
field_note() {
	_FN=""
	case $_FL_NOTE in
	*"$NL$1="*) _FN=${_FL_NOTE#*"$NL$1="}; _FN=${_FN%%"$NL"*} ;;
	esac
}

# What a finding says when a value does not match. The format's patterns are
# compiled into this script, so nobody can open the file they live in: the
# finding shows the note, which is the same grammar in words. A project's
# pattern is in a file the project wrote, so naming it points at the line to
# go and read.
match_complaint() {
	field_note "$1"
	if [ -n "$_FN" ] && [ "$_FN" != - ]
	then _MC="is not $_FN"
	else _MC="does not match $2"; fi
}

# The pattern for one field, from the format if it owns the name and from the
# project's schema otherwise. The format wins, which is what "the project
# cannot weaken these" comes down to at the one place it is read.
field_match() {
	_fm_p=$(format_cached | awk -F'\t' -v k="$2" '$1 == k && $3 != "-" { print $3; exit }')
	[ -n "$_fm_p" ] && { printf '%s\n' "$_fm_p"; return 0; }
	schema_match "$1" "$2"
}

# Parsed once per command. check asks for it per ticket and info_faults per
# field; reparsing there would put a process per field per ticket back into
# the one place the whole design is built to keep to a single pass.
schema_cached() {
	if [ -z "${_schema_read:-}" ]; then
		_schema_tab=$(schema_table "$1")
		_schema_read=yes
	fi
	printf '%s\n' "$_schema_tab"
}

# Field names the schema declares, one per line, in declaration order.
schema_fields() { schema_cached "$1" | awk -F'\t' '$1 != "" { print $1 }'; }

# The pattern one field's value must match, or nothing.
schema_match() {
	schema_cached "$1" | awk -F'\t' -v k="$2" '$1 == k && $3 != "-" { print $3; exit }'
}

# Does this value match this pattern? 0 yes, 1 no, 2 the pattern is unusable —
# which is a fault in the schema, not in the ticket, and is reported once by
# schema_faults rather than against every ticket that has the field.
#
# grep, never awk. mawk 1.3.4 has no interval expressions: [0-9]{4} matches
# 2026 under grep -E and does not under mawk, in a literal /re/ or in a
# dynamic $0 ~ p, and gawk differs again. A pattern's meaning must not depend
# on which awk is installed.
#
# Anchored here rather than in the schema: ^(...)$ so that S|M|L cannot
# half-match "M extra", and a pattern its author already anchored still works.
value_matches() {
	grep -Eq "^($1)\$" 2>/dev/null <<VALUE
$2
VALUE
}

# Everything wrong with the schema itself, one finding per line. Reported by
# check once, not per ticket: a bad pattern is one mistake however many
# tickets carry the field.
schema_faults() {
	_sf_r=$1 _sf_f=$(schema_file "$1")
	[ -f "$_sf_f" ] || { printf 'schema: %s does not exist\n' "$_sf_f"; return 0; }

	# \047 is the apostrophe: the program is inside single quotes, so it
	# cannot contain one.
	awk -v mine="$(format_fields)" '
		BEGIN {
			q = "\047"
			n = split(mine, f, "\n")
			for (i = 1; i <= n; i++) if (f[i] != "") owned[f[i]] = 1
		}
		function say(msg) { print "schema: " msg ", at line " NR }
		{ sub(/^[ \t]+/, "") }
		/^#/ { next }
		$0 == "" { open = 0; next }
		{
			# line: is rejected wherever it appears, and without
			# disturbing the stanza: the field: under it is still
			# the line that opens one.
			if ($1 == "line:") {
				say("line: is the format" q "s own, not a schema key")
				next
			}
			if (!open) {
				open = 1
				if ($1 != "field:") { say("a stanza with no field:"); next }
				if (NF != 2) { say("field: takes one name"); next }
				if ($2 in seen) say(q $2 q " is declared twice")
				seen[$2] = 1
				if ($2 in owned)
					say(q $2 q " is the format" q "s own and is not declared here")
				next
			}
			if ($1 == "field:") { say("a second field: inside a stanza"); next }
			if ($1 == "required:") {
				if ($2 != "yes" && $2 != "no") say("required: takes yes or no")
				next
			}
			if (index($0, "match:") == 1 || index($0, "note:") == 1) {
				if (index($0, "match:") == 1 && index($0, "\t") > 0)
					say("a match with a tab in it")
				next
			}
			say(q $1 q " is not a schema key")
		}' "$_sf_f"

	# The patterns, which only grep can judge. A permissive grep is the
	# hazard: ugrep 7.8.4 accepts \d, where GNU grep -E leaves it undefined,
	# so a pattern written against whichever tool is installed here can mean
	# something else on the next machine. Lint the text, then ask grep
	# whether it compiles at all — exit 2 rather than 1 says it does not.
	schema_cached "$_sf_r" | while IFS='	' read -r _sf_k _sf_req _sf_pat _sf_rest; do
		[ -n "$_sf_k" ] && [ "$_sf_pat" != - ] || continue
		case $_sf_pat in
		*'\d'*|*'\w'*|*'\s'*|*'\b'*|*'(?'*)
			printf "schema: '%s' uses a PCRE escape, which is not ERE\n" "$_sf_k" ;;
		esac
		_sf_rc=0; value_matches "$_sf_pat" x || _sf_rc=$?
		[ "$_sf_rc" -le 1 ] ||
			printf "schema: '%s' has a match grep cannot compile\n" "$_sf_k"
	done
}

# "number<TAB>state<TAB>blockers<TAB>title" for every open ticket, computed
# from one traversal and the first three lines of each file. No bodies are
# read. state is ready, blocked or claimed.
survey() {
	_sv_r=$1
	map "$_sv_r" | awk -v root="$_sv_r" -v now="$(now_iso)" '
		# Relative to root, for the reason in in_closed().
		{ closed[$1] = (substr($2, length(root) + 2) ~ /(^|\/)c\//)
		  path[$1] = $2 }
		END {
			for (n in path) {
				if (closed[n]) continue
				f = path[n] "/info"
				claim = ""; needs = ""; title = ""; defer = ""
				getline claim < f
				getline needs < f
				getline title < f
				# The one field this view reads. It stops at the
				# blank line that ends the block, so the body is
				# never touched — and it is the same single pass,
				# which is what the cost is about.
				while ((getline line < f) > 0) {
					if (line == "") break
					if (index(line, "defer:") == 1) {
						defer = substr(line, 7)
						sub(/^ +/, "", defer)
						break
					}
				}
				close(f)
				sub(/^claim:/, "", claim)
				sub(/^needs:[ ]?/, "", needs)
				sub(/^title:[ ]?/, "", title)

				# A lease that has run out is takeable, and claim
				# grants it. This view said "claimed" and offered
				# nothing, which is ready work no listing showed.
				#
				# Deciding it here costs nothing: the expiry is
				# on the line and ISO-8601 sorts lexically, so it
				# is a string comparison. Judging a pid is the
				# other half of claim_state and needs the process
				# table — a process per ticket — so this pass
				# leaves a dead claim reading as claimed, which
				# is what claim says about it too: reap clears it.
				lapsed = ""
				sp = index(claim, " ")
				if (sp > 0 && substr(claim, sp + 1) <= now) {
					who = substr(claim, 1, sp - 1)
					at = index(who, "@")
					lapsed = at > 1 ? substr(who, 1, at - 1) : who
					claim = ""
				}
				blockers = ""
				k = split(needs, d, " ")
				for (i = 1; i <= k; i++)
					if (!(d[i] in path) || !closed[d[i]])
						blockers = blockers (blockers ? "," : "") d[i]
				# Blocked first: a dependency is a fact about the
				# tracker, and deferred is an opinion about the
				# work. Claimed last, because someone holding a
				# deferred ticket has already decided.
				state = blockers != "" ? "blocked" : \
					(claim != "" ? "claimed" : \
					(defer != "" ? "deferred" : "ready"))
				# "-" rather than empty: tab is IFS whitespace, so a
				# shell read collapses two tabs into one and every
				# later field shifts left.
				why = blockers ? blockers : \
					(defer ? defer : (lapsed ? lapsed : "-"))
				printf "%s\t%s\t%s\t%s\n", n, state, why, title
			}
		}'
}

cmd_list() {
	_all=no _stale=""
	while [ $# -gt 0 ]; do
		case $1 in
		-a|--all) _all=yes; shift ;;
		-s|--stale) [ $# -ge 2 ] || die 'usage: pidly list [-a] [--stale 7d]'
		            _stale=$2; shift 2 ;;
		-*) die "unknown option $1" ;;
		*)  break ;;
		esac
	done
	[ $# -eq 0 ] || die 'usage: pidly list [-a] [--stale 7d]'
	_r=$(root)

	# Work nobody has touched lately. This is the one query that reads a
	# field rather than the first three lines, which is what the field is
	# for: without it the same question is a git log per ticket.
	if [ -n "$_stale" ]; then
		_secs=$(duration_seconds "$_stale") ||
			die "--stale takes a duration like 90s, 30m, 2h or 7d, not '$_stale'"
		_cut=$(iso_at "$(( $(date -u +%s) - _secs ))")
		map "$_r" | while read -r _n _p; do
			case $_n in ''|*[!0-9]*) continue ;; esac
			in_closed "$_r" "$_p" && continue
			[ -f "$_p/info" ] || continue
			_u=$(get_field "$_p/info" updated)
			# An undated ticket cannot be shown to be fresh, and the
			# point of the question is what has been forgotten, so it
			# is listed rather than assumed well.
			[ -n "$_u" ] && ! before "$_u" "$_cut" && continue
			_day=${_u%%T*}
			[ -n "$_day" ] || _day=-
			printf '%-5s %-11s %s\n' "$_n" "$_day" \
				"$(sed -n '3s/^title: //p' "$_p/info")"
		done | LC_ALL=C sort -k2,2 -k1,1n
		return 0
	fi
	survey "$_r" | sort -n | while IFS='	' read -r _n _st _bl _ti; do
		if [ "$_all" = no ]; then
			[ "$_st" = ready ] || continue
			printf '%-5s %s\n' "$_n" "$_ti"
		elif [ "$_st" = blocked ]; then
			printf '%-5s %-8s %s (needs %s)\n' "$_n" "$_st" "$_ti" "$_bl"
		elif [ "$_st" = deferred ]; then
			printf '%-5s %-8s %s (until %s)\n' "$_n" "$_st" "$_ti" "$_bl"
		elif [ "$_st" = ready ] && [ "$_bl" != - ]; then
			printf '%-5s %-8s %s (%s left a lease that ran out)\n' \
				"$_n" "$_st" "$_ti" "$_bl"
		else
			printf '%-5s %-8s %s\n' "$_n" "$_st" "$_ti"
		fi
	done
}

# One field, read from every ticket in a single pass.
#
# The cross-ticket question — what is the effort spread, which tickets have
# no area — is otherwise a loop that spawns a process per ticket. Over 2000
# tickets that is 17.4s against 0.44s for one awk.
#
# The field is matched by name rather than by line number. Both measured the
# same (0.43s against 0.44s), and a scanning reader is still correct for a
# ticket written before the current schema, where a positional one is
# silently wrong for exactly the tickets worth looking at.
#
# Rows, not a summary: aggregating is sort | uniq -c on this output, and a
# ticket missing the field prints - so the gap shows up in that tally, which
# is usually the question being asked.
# One ticket, or less of it. pidly field prints one field across every ticket;
# this is the other direction, every field of one ticket, and the flags are
# the parts of an info file a caller would otherwise reach for with sed or
# awk. The reference publishes those idioms and goes on publishing them: this
# is a convenience over the format, never a replacement for reading it.
#
# -p prints the directory, which is the primitive every hand idiom needs —
# resolving a number was required to do almost anything else by hand. It
# invites callers to build on a path, which is principle 1 working, but a
# path is not a licence to hand-edit lines that a command should write: see
# set for title and needs, and reparent for the directory itself.
cmd_show() {
	_sh_mode=all _sh_k=""
	while [ $# -gt 0 ]; do
		case $1 in
		-p|--path)   _sh_mode=path; shift ;;
		-F|--fields) _sh_mode=fields; shift ;;
		-b|--body)   _sh_mode=body; shift ;;
		-f|--field)
			[ $# -ge 2 ] || die 'pidly show -f wants a field name'
			_sh_mode=field; _sh_k=$2; shift 2 ;;
		-*) die "unknown option $1" ;;
		*)  break ;;
		esac
	done
	[ $# -eq 1 ] || die 'usage: pidly show [-p|-F|-b|-f <name>] <number>'
	# Not checked against the schema, for the reason field does not check
	# either: a ticket written by hand is a legal ticket and may carry a key
	# the schema never declared. An absent field prints nothing.
	if [ "$_sh_mode" = field ]; then
		case $_sh_k in
		''|*:*) die "a field name, not '$_sh_k'" ;;
		esac
	fi
	_r=$(root); _sh_d=$(ticket_dir "$_r" "$1"); _sh_f="$_sh_d/info"
	[ "$_sh_mode" = path ] || [ -f "$_sh_f" ] ||
		die "$1 has no info file in $_sh_d"
	case $_sh_mode in
	path)   printf '%s\n' "$_sh_d" ;;
	all)    cat "$_sh_f" ;;
	fields) awk 'NR > 3 { if ($0 == "") exit; print }' "$_sh_f" ;;
	body)   get_body "$_sh_f" ;;
	field)  get_field "$_sh_f" "$_sh_k" ;;
	esac
	return 0
}

cmd_field() {
	_all=no
	while [ $# -gt 0 ]; do
		case $1 in
		-a|--all) _all=yes; shift ;;
		-*) die "unknown option $1" ;;
		*)  break ;;
		esac
	done
	[ $# -eq 1 ] || die 'usage: pidly field [-a] <name>'
	case $1 in ''|*:*) die "a field name, not '$1'" ;; esac
	_r=$(root)

	# nextfile is not POSIX, so the per-file stop is the blank line that
	# ends the field block: read the three structural lines, then read
	# until the field, the body boundary, or the end of the file.
	map "$_r" | awk -v root="$_r" -v k="$1" -v all="$_all" '
		{
			n = $1
			if (n ~ /[^0-9]/) next
			# Relative to root, for the reason in in_closed().
			if (all != "yes" &&
			    substr($2, length(root) + 2) ~ /(^|\/)c\//) next
			f = $2 "/info"
			v = ""
			for (i = 1; i <= 3; i++)
				if ((getline line < f) <= 0) break
			while ((getline line < f) > 0) {
				if (line == "") break
				# index(), not a regex: a field name is matched
				# literally, whatever characters it holds.
				if (index(line, k ":") == 1) {
					v = substr(line, length(k) + 2)
					sub(/^ +/, "", v)
					break
				}
			}
			close(f)
			# A field present but empty is the same gap as a field
			# that is absent: nobody has answered the question.
			printf "%-5s %s\n", n, v == "" ? "-" : v
		}' | sort -n
}

# Children under their parent, closed ones marked.
#
# Not recursive. A recursive shell function cannot hold loop state: POSIX
# shell has one variable namespace, so the inner call clobbers the outer
# one's cursor, and prefixing names per function does not help when the
# function collides with itself. Instead each ticket's path becomes a sort
# key of zero-padded ancestor numbers, which puts parents before children
# and siblings in numeric order in a single pass.
#
# The sort runs under LC_ALL=C. A locale-aware collation ignores the "/"
# between segments, which puts a child ahead of its own parent.
cmd_tree() {
	[ $# -eq 0 ] || die 'usage: pidly tree'
	_r=$(root)
	map "$_r" | awk -v root="$_r" '
		{
			rel = $2
			sub("^" root "/", "", rel)
			n = split(rel, seg, "/")
			key = ""; depth = 0; closed = 0
			for (i = 1; i <= n; i++) {
				if (seg[i] == "c") { closed = 1; continue }
				key = key sprintf("%09d/", seg[i])
				depth++
			}
			f = $2 "/info"
			title = ""
			getline title < f; getline title < f; getline title < f
			close(f)
			sub(/^title:[ ]?/, "", title)
			printf "%s\t%d\t%s\t%s\t%s\n", key, depth, closed, $1, title
		}' | LC_ALL=C sort | while IFS='	' read -r _k _depth _closed _num _title; do
		_ind=''
		_i=1
		while [ "$_i" -lt "$_depth" ]; do _ind="$_ind  "; _i=$((_i + 1)); done
		[ "$_closed" = 1 ] && _mk='[x]' || _mk='[ ]'
		printf '%s%s %-4s %s\n' "$_ind" "$_mk" "$_num" "$_title"
	done
}

# --- check -----------------------------------------------------------------
#
# Reports; never modifies. That is what lets it run in CI and what lets
# anyone run it without thinking about what it might do.

# Findings go to a file, not a variable. Almost every check below runs
# inside a pipeline, and a pipeline's commands run in subshells, so a counter
# incremented there never reaches this one.
flag() { printf '%s\n' "$*" >> "$PIDLY_REPORT"; }

# A note is something to know, not something wrong: it is printed and it does
# not change the exit status. Drift is the case that needs this — a ticket
# written by hand is a legal ticket, and it will not carry a slot for every
# field the schema has grown. Failing CI over that would make the format's
# own promise — mkdir and an editor — the thing that breaks the build.
note() { printf '%s\n' "$*" >> "$PIDLY_NOTES"; }

cmd_check() {
	[ $# -eq 0 ] || die 'usage: pidly check'
	_r=$(root)
	PIDLY_REPORT="${TMPDIR:-/tmp}/pidly.report.$$"
	PIDLY_NOTES="${TMPDIR:-/tmp}/pidly.notes.$$"
	export PIDLY_REPORT PIDLY_NOTES
	: > "$PIDLY_REPORT"
	: > "$PIDLY_NOTES"
	_m=$(map "$_r")
	# Every number, newline-delimited and newline-wrapped, so a glob can
	# ask "is this one of them" without a process.
	_nums="
$(printf '%s\n' "$_m" | awk '{print $1}')
"

	# The schema first: a fault there is one mistake that would otherwise be
	# reported against every ticket carrying the field.
	schema_faults "$_r" | while read -r _sfault; do
		[ -n "$_sfault" ] || continue
		flag "$_sfault"
	done
	if [ -f "$_r/schema.md" ]; then
		flag "schema.md is not read any more — the schema is $(schema_file "$_r")"
	fi

	# One number, one ticket.
	printf '%s\n' "$_m" | awk '{print $1}' | sort | uniq -d | while read -r _d; do
		[ -n "$_d" ] || continue
		flag "$_d: issued to more than one ticket"
	done

	printf '%s\n' "$_m" | while read -r _num _path; do
		[ -n "$_num" ] || continue
		# A non-numeric directory is flagged by its parent below. Checking
		# it as a ticket would report the same fault three more times.
		case $_num in *[!0-9]*) continue ;; esac
		_f="$_path/info"

		[ -f "$_f" ] || { flag "$_num: no info file in $_path"; continue; }

		# Straight into the report rather than through a pipeline.
		# flag() only appends to this file, and the pipe cost a
		# subshell per ticket — which is also what reset the parsed
		# schema and format each time round the loop.
		info_faults "$_r" "$_f" "$_num" >> "$PIDLY_REPORT"

		# The two structural lines this loop reads for itself, in one
		# pass and no process: claim: is line 1 and needs: is line 2, and
		# a sed apiece was two forks per ticket for a handful of bytes.
		_held="" _needline=""
		{ IFS= read -r _held; IFS= read -r _needline; } < "$_f" || true
		case $_held in claim:*) _held=${_held#claim:} ;; *) _held="" ;; esac

		# Dependencies resolve. The numbers are in _nums, built once
		# above; matching a glob against it costs nothing, where an awk
		# per dependency was a process per dependency per ticket.
		for _dep in ${_needline#needs:}; do
			case $_nums in
			*"
$_dep
"*) ;;
			*) flag "$_num: needs $_dep, which does not exist" ;;
			esac
		done

		# A ticket holds its info, child tickets, c/ and attachments-free
		# directories only. Anything else is read as a phantom ticket.
		for _sub in "$_path"/*/; do
			[ -d "$_sub" ] || continue
			_sn=${_sub%/}; _sn=${_sn##*/}
			[ "$_sn" = c ] && continue
			case $_sn in
			''|*[!0-9]*) flag "$_num: '$_sn/' is neither a number nor c"
			             continue ;;
			esac
			# A numbered directory sitting here is an open child, and a
			# finished tree may not hold live work. Only the parent can
			# see this: the child's own path says c/ and looks closed.
			in_closed "$_r" "$_path" &&
				flag "$_num: closed, but child $_sn is open"
		done

		# Claims and locks whose holder is gone.
		if [ -n "$_held" ]; then
			case $(claim_state "$_r" "$_held") in
			dead) flag "$_num: claimed by $_held, which is gone" ;;
			esac
		fi
		if [ -e "$_path/.lock" ]; then
			_lo=""
			read -r _lo < "$_path/.lock" 2>/dev/null || true
			if [ -z "$_lo" ]; then
				flag "$_num: a lock with no owner"
			elif ! kill -0 "$_lo" 2>/dev/null; then
				flag "$_num: a lock held by $_lo, which is gone"
			fi
		fi
	done

	# The registry, both directions.
	printf '%s\n' "$_m" | while read -r _num _path; do
		[ -n "$_num" ] || continue
		case $_num in *[!0-9]*) continue ;; esac
		[ -e "$(registry_dir "$_r")/$_num" ] ||
			flag "$_num: no registry entry, so nothing stops a branch reusing it"
	done
	if [ -d "$(registry_dir "$_r")" ]; then
		# The glob again, for the same reason: an awk per entry over the
		# whole map is a process per ticket reading every ticket, which
		# is the one shape in here that gets worse as the tracker grows.
		ls "$(registry_dir "$_r")" 2>/dev/null | while read -r _e; do
			[ -n "$_e" ] || continue
			case $_nums in
			*"
$_e
"*) ;;
			*) flag "registry has $_e with no ticket (deleted?)" ;;
			esac
		done
	fi

	# Declared fields a ticket has no line for. Reported per field rather
	# than per ticket: a stanza added to the schema today is missing from every
	# ticket at once, and that is one fact, not two thousand of them. It is
	# also the dry run for the migration — what 'pidly fields' would add,
	# from the command that changes nothing.
	#
	# Required fields are left out: a ticket without a value for one is
	# already reported above, by ticket, and by value rather than by slot.
	_decl=$(slate_fields "$_r")
	_req=$(schema_required "$_r")
	if [ -n "$_decl" ]; then
		printf '%s\n' "$_m" | while read -r _num _path; do
			[ -n "$_num" ] || continue
			case $_num in *[!0-9]*) continue ;; esac
			[ -f "$_path/info" ] || continue
			missing_fields "$_path/info" "$_decl"
			printf '\n'
		done | tr ' ' '\n' | grep -v '^$' | sort | uniq -c |
		while read -r _fc _fk; do
			printf '%s\n' "$_req" | grep -qx "$_fk" && continue
			note "$_fc ticket(s) have no '$_fk' line — run 'pidly fields'"
		done
	fi

	# Cycles, by peeling nodes with no unresolved dependency.
	# One awk for the whole graph: line 2 of every info, read with getline.
	# The shell loop this replaces ran a sed per ticket.
	printf '%s\n' "$_m" | awk '
		$1 ~ /^[0-9]+$/ {
			f = $2 "/info"
			line = ""
			getline line < f; getline line < f
			close(f)
			sub(/^needs:[ ]*/, "", line)
			print $1 " " line
		}' | awk '
		{ node[$1] = 1; for (i = 2; i <= NF; i++) dep[$1] = dep[$1] " " $i }
		END {
			changed = 1
			while (changed) {
				changed = 0
				for (n in node) {
					if (done[n]) continue
					k = split(dep[n], d, " "); ok = 1
					for (i = 1; i <= k; i++)
						if (d[i] in node && !done[d[i]]) ok = 0
					if (ok) { done[n] = 1; changed = 1 }
				}
			}
			for (n in node) if (!done[n]) print n
		}' | sort -n | while read -r _c; do
		[ -n "$_c" ] || continue
		flag "$_c: in a needs cycle"
	done

	# The generated documents, against what would be generated now.
	_tmp="${TMPDIR:-/tmp}/pidly.check.$$"
	guide_text > "$_tmp"
	cmp -s "$_tmp" "$_r/README.md" ||
		flag "README.md is out of date — run 'pidly agents'"
	# The Claude Code files, if this project has them. Only if: a project
	# that never ran 'pidly claude' is not missing anything.
	claude_files | while read -r _cf_p _cf_fn; do
		[ -f ".claude/$_cf_p" ] || continue
		"$_cf_fn" > "$_tmp"
		cmp -s "$_tmp" ".claude/$_cf_p" ||
			flag ".claude/$_cf_p is out of date — run 'pidly claude'"
	done

	for _cand in AGENTS.md CLAUDE.md GEMINI.md .cursorrules; do
		[ -f "$_cand" ] || continue
		grep -qF "$AGENTS_BEGIN" "$_cand" || continue
		awk -v b="$AGENTS_BEGIN" -v e="$AGENTS_END" '
			index($0, b) { p = 1 } p { print } index($0, e) { exit }
		' "$_cand" > "$_tmp"
		agents_block | cmp -s - "$_tmp" ||
			flag "$_cand's pidly section is out of date — run 'pidly agents'"
	done
	rm -f "$_tmp"

	[ -s "$PIDLY_NOTES" ] && sort "$PIDLY_NOTES" | sed 's/^/note: /'
	rm -f "$PIDLY_NOTES"
	if [ -s "$PIDLY_REPORT" ]; then
		sort "$PIDLY_REPORT"
		printf '%s problem(s)\n' "$(wc -l < "$PIDLY_REPORT" | tr -d ' ')"
		rm -f "$PIDLY_REPORT"
		return 1
	fi
	rm -f "$PIDLY_REPORT"
	printf 'ok: %s tickets\n' "$(printf '%s\n' "$_m" | grep -c . || true)"
	return 0
}

# --- entry point -----------------------------------------------------------

usage() {
	cat >&2 <<'USAGE'
usage: pidly <command> [args]

  init           create .pidly here, or refresh what it generates
  new [-p N] [-n "3 8"] [-f name=value] <title>
                 create a ticket, optionally under parent N, optionally
                 blocked on other tickets; -f sets a field, and every field
                 the schema requires needs one; body is read from stdin
  claim <n>      take ticket n
  release [-m note] <n>
                 give it back, optionally recording where you got to
  status <n>     who holds it, and whether that can be verified
  reap [n]       clear claims whose process is positively gone, one ticket or
                 the whole tracker; never a claim it cannot check
  edit [-a|-b] <n>
                 open it in $EDITOR; -b replaces the body from stdin, -a
                 appends to it
  set <n> <field> [value]
                 write a project field; with no value, clear it
  fields         give every ticket a slot for every field the schema declares,
                 adding keys only — never removing, reordering or restamping
  close <n>      finish it: move it into its container's c/
  reopen <n>     move it back, reopening any closed ancestors
  list [-a] [--stale 7d]
                 takeable work — unclaimed, unblocked and not deferred; -a
                 shows every open ticket with its state; --stale shows open
                 work untouched for that long, oldest first
  field [-a] <name>
                 that field's value in every open ticket, one row each, - for
                 a ticket that has no value; -a includes closed work
  show [-p|-F|-b|-f <name>] <n>
                 one ticket: the whole info file, or -p its directory, -F its
                 field block, -b its body, -f one field's value
  tree           the hierarchy, closed tickets marked [x]
  check          report anything wrong; changes nothing, nonzero if it finds
                 something, so it can run in CI. Notes — drift a migration
                 would close — are printed without failing it
  agents [-f F]  write .pidly/README.md and a summary into AGENTS.md (or F),
                 replacing the summary if already present
  claude         write the Claude Code integration into .claude: a skill, the
                 slash commands, and a permissions block for the read-only
                 commands

environment:
  PIDLY_PID      the agent's process (default: $CLAUDE_PID, else $PPID).
                 Recorded with its start time, so a recycled pid is never
                 mistaken for it.
  PIDLY_AGENT    an agent with no local process — a cloud session, a CI job.
                 Requires PIDLY_LEASE: nothing else can show it is alive.
  PIDLY_LEASE    how long the claim is good for: 90s, 30m, 2h, 3d.

USAGE
	exit 2
}

[ $# -ge 1 ] || usage
cmd=$1; shift
case $cmd in
init)    cmd_init "$@" ;;
new)     cmd_new "$@" ;;
claim)   cmd_claim "$@" ;;
release) cmd_release "$@" ;;
status)  cmd_status "$@" ;;
reap)    cmd_reap "$@" ;;
edit)    cmd_edit "$@" ;;
close)   cmd_close "$@" ;;
reopen)  cmd_reopen "$@" ;;
list)    cmd_list "$@" ;;
field)   cmd_field "$@" ;;
show)    cmd_show "$@" ;;
set)     cmd_set "$@" ;;
fields)  cmd_fields "$@" ;;
tree)    cmd_tree "$@" ;;
check)   cmd_check "$@" ;;
agents)  cmd_agents "$@" ;;
claude)  cmd_claude "$@" ;;
*)       usage ;;
esac
